// Theorem 11.3.2.1 (Orbital Traces on the Paley-Wiener Levels), DECOMPOSED.
//
// WHY THIS FILE EXISTS. 11.3.2.1 was one bare hole in `trace-formula.b4m`, justified as
// "it IS the analysis". Proving it does need foundations this formalization lacks. But its
// proof (txt 29947-30035) is a CHAIN of six moves, each citing a specific named result, and
// recording that chain is not the same as proving the analysis:
//
//   1. the indented kernel VANISHES unless xi maps to a uniformizer in some v in P_{k+1}-P_k
//   2. so the relevant xi's support sits inside GL_1(A_{F,S'}) x prod_{v not in S'} O_v^x
//   3. multiplying by the stratum indicator alpha_k PRESERVES the left side's value
//   4. the truncations CONVERGE in W_I^s(C_F)                     [Thm 11.1.2.1 — author's]
//   5. the converged value IS the trace of a nuclear operator     [Prop 12.2.2.2 — author's]
//   6. that operator is a nuclear LIMIT OF FINITE RANKS           [Thm 10.3.2.1 — author's]
//      so its trace is the limit of theirs                        [classical, operator-theory]
//   7. the limit value is the right side of (7.4.2.1)             [Thm 7.4.2.1 — author's]
//      and the Theorem follows by Poisson summation               [Prop B.4.1.2 — classical]
//
// The author's own results (steps 4-7) are cited as `manuscript-proved:` — they are PROVED
// in the released text, so they are neither gaps nor classical; a future round can transcribe
// any one of them, and the interface here will not change.
//
// WHAT THIS BUYS, AND WHAT IT DOES NOT. Be precise about this, because an adversarial audit
// found the earlier claim here overstated and it was right.
//
// LOGICALLY, the chain below is TRANSITIVITY. Five of its intermediate predicates
// (contributesAtStratum, indicatorPreservesTheValue, truncationsConvergeIn,
// inducesAContinuousOperator, isTheNuclearLimitOfFiniteRanks) are opaque and each occurs in
// exactly two places: one hole's conclusion and the next hole's antecedent. A probe confirms
// a SINGLE hole reaches this file's conclusion with the same strength. So the six holes are
// not six independent facts the kernel has related — they are one assumption, spelled across
// six names, plus transitivity of `->`.
//
// WHAT IT STILL BUYS is bookkeeping, not logic: each hole pins ONE sentence of the author's
// proof to ONE named result (Thm 11.1.2.1, Prop 12.2.2.2, Thms 10.3.2.1 / 11.2.2.1,
// Thm 7.4.2.1, Prop B.4.1.2), so `--axioms` reports six auditable transcription tasks with
// citations a reader can check, where before it reported one opaque black box. That is worth
// having for TRIAGE — it is how you find out that two of the six are classical and four are
// the author's own proved theorems — but it is NOT depth, and this file should not be read as
// having verified the analysis.
//
// The honest summary: the SEQUENCE of the author's argument is recorded and checked; the
// CONTENT of each step is assumed. Closing that gap means defining the predicates, which
// needs real measure theory and functional analysis, which this encoding does not build.
//
// ALTITUDE: opaque. No measure theory, no topology. These are the INTERFACES.

theory vocab <<< "../shared/vocabulary.b4m"
theory operator_theory <<< "operator-theory.b4m"
theory haar <<< "haar-integration.b4m"

sort TestFunction = vocab.TestFunction
sort Quantity = vocab.Quantity
sort PlaceSet = vocab.PlaceSet

sort Kernel = operator_theory.Kernel
sort Operator = operator_theory.Operator
sort HardySobolevSpace = operator_theory.HardySobolevSpace

pred isNuclearOn = operator_theory.isNuclearOn
pred isTheNuclearLimitOfFiniteRanks = operator_theory.isTheNuclearLimitOfFiniteRanks
pred truncationsConvergeIn = operator_theory.truncationsConvergeIn
pred inducesAContinuousOperator = operator_theory.inducesAContinuousOperator
oper operatorOf = operator_theory.operatorOf
oper trace = operator_theory.trace
fact nuclearLimitsAreNuclear = operator_theory.nuclearLimitsAreNuclear
fact theDiagonalIntegralIsTheIteratedIntegral = haar.theDiagonalIntegralIsTheIteratedIntegral
fact convergentKernelsAreTraceClassFiniteRankLimits =
  haar.convergentKernelsAreTraceClassFiniteRankLimits
fact theTraceIsTheSpectralSum = haar.theTraceIsTheSpectralSum
pred hasAnAbsolutelySummableSpectrum = haar.hasAnAbsolutelySummableSpectrum

// ---------------------------------------------------------------------------------------
// the objects of 11.3.2.1's statement
// ---------------------------------------------------------------------------------------

/// a stratum index k >= 0 of the divisorial filtration
sort StratumIndex

/// the indented kernel (alpha_{k+1} - alpha_k) k_geom^Delta at stratum k, for a test
/// function. The Delta-subscript is the indentation along u_0 of (11.3.2.2).
oper theIndentedStratumKernel(k: StratumIndex, f: TestFunction) => Kernel

/// the orbital integral: the left side of (11.3.2.1), summed over xi in F^x and integrated
/// over g in E_F^1 against dmu_1(g) dt/t
oper theOrbitalIntegral(k: StratumIndex, f: TestFunction) => Quantity

/// the right side of (11.3.2.1): (log q_v / mu_v(O_Fv)) x sum_{k in Z} phi(pi_v^k)
oper theLocalEulerContribution(k: StratumIndex, f: TestFunction) => Quantity

/// the right side of (7.4.2.1): sum over the zeros eps_p of the local-Euler-factor product
oper theZeroSideValue(f: TestFunction) => Quantity

/// the Paley-Wiener level W_I^s(C_F) at the manuscript's parameters (a = 1/2, s > 1, I)
const thePaleyWienerLevel: HardySobolevSpace

// ---------------------------------------------------------------------------------------
// the hypotheses 11.3.2.1 carries
// ---------------------------------------------------------------------------------------

/// S contains the Archimedean places, the places where F/Q ramifies, the places where chi
/// ramifies, and phi is invariant under prod_{v not in S} O_Fv^x; and Pic(O_{F,S}) = 1
pred isAdmissibleForOrbitalTraces(s: PlaceSet, f: TestFunction)

/// phi is supported over C_F^{>1} — the standing support hypothesis of 11.3.2.1
pred isSupportedAboveOne(f: TestFunction)

/// stratum k's prime is NOT the residue characteristic of any finite place in S. This is
/// the manuscript's "p nmid S" condition (txt 31556), and without it the vanishing claim is
/// FALSE: the in-S strata are exactly the ones whose contribution does not vanish.
pred isOffTheSetOfPlaces(k: StratumIndex, s: PlaceSet)

/// the xi's contributing at stratum k map to a uniformizer in some place of P_{k+1} - P_k;
/// the manuscript calls this set Xi_k
pred contributesAtStratum(k: StratumIndex, f: TestFunction)

/// multiplying by the stratum indicator alpha_k leaves the orbital integral's value
/// unchanged (for k >= k_0, k_0 large enough that alpha_k's support contains the carving)
pred indicatorPreservesTheValue(k: StratumIndex, f: TestFunction)

intheory theOrbitalTraceIsTheEulerContribution

// ---------------------------------------------------------------------------------------
// STEP 1-3: the support argument. The manuscript's first three moves are bookkeeping about
// WHERE the kernel is nonzero, and it states them as observations.
// ---------------------------------------------------------------------------------------

/// The indented kernel vanishes unless xi maps to a uniformizer in some v in P_{k+1} - P_k.
/// "We observe that k_geom^Delta(tau(t), xi g tau(t)) vanishes unless xi in F^x maps to a
/// uniformizer in F_v^x for some v in P_{k+1} - P_k" (txt 29971).
hole theIndentedKernelVanishesOffTheStratum
  cites "assertion: the author opens the proof with 'We observe that ...' (txt 29971) — the vanishing of the indented kernel off the stratum's uniformizers is stated as an observation about his own indentation u_0, not argued":
  forall k: StratumIndex; forall f: TestFunction; forall s: PlaceSet;
  isAdmissibleForOrbitalTraces(s, f) -> isSupportedAboveOne(f) ->
  contributesAtStratum(k, f)

/// Multiplying by the stratum indicator alpha_k preserves the orbital integral's value,
/// for k >= k_0 with k_0 large enough. "Multiplication of ... by the indicator function
/// alpha_k ... for a suitable large enough integer k_0 >= 0 such that the support of alpha_k
/// contains GL_1(A_{F,S'}) x prod O_Fv^x, preserves the value of the left side" (txt 29983).
hole theStratumIndicatorPreservesTheValue
  cites "assertion: txt 29983 states the preservation as part of the construction ('for a suitable large enough integer k_0'), without an estimate — the choice of k_0 is asserted to exist":
  forall k: StratumIndex; forall f: TestFunction;
  contributesAtStratum(k, f) -> indicatorPreservesTheValue(k, f)

// ---------------------------------------------------------------------------------------
// STEP 4-6: the analysis. Each cites one of the author's own PROVED theorems.
// ---------------------------------------------------------------------------------------

/// STEPS 4-6, COLLAPSED OVER THE NUCLEARITY SHIM. The manuscript takes three steps here: the
/// truncations converge in W_I^s (his Thm 11.1.2.1), the converged kernel induces a
/// continuous operator (Prop 12.2.2.2), and that operator is a trace-norm limit of finite
/// ranks (the estimates of Thm 10.3.2.1).
///
/// Encoded one-per-step those were three BARE holes relating four opaque predicates, each
/// occurring exactly twice — the glue pattern an audit of this repo flagged, where the chain
/// is transitivity rather than content. `standard/haar-integration.b4m` instead states the
/// CLASSICAL theorem spanning all three (Grothendieck's kernel theorem plus density of finite
/// ranks in the trace class), which is what his three results specialize.
///
/// Three transcription tasks become one classical citation plus two located readings.

/// the stratum kernel, as an indented kernel in the shim's sense
oper theStratumIndentedKernel(k: StratumIndex, f: TestFunction) => haar.IndentedKernel

hole theManuscriptSettingIsNuclear
  cites "assertion: that the manuscript's truncation process is a convergent kernel sequence in the sense the classical nuclearity theorem requires is his specialization of it. His proof cites Thm 11.1.2.1 for the convergence (txt 29991) without restating what the nuclearity argument needs of it":
  forall k: StratumIndex; forall f: TestFunction;
  indicatorPreservesTheValue(k, f) ->
  haar.kernelSequenceConverges(theStratumIndentedKernel(k, f))

hole theShimConclusionGivesTheOperatorFacts
  cites "assertion: the manuscript reads the classical conclusion as delivering both that the kernel induces a continuous operator on W_I^s and that the induced operator is a trace-norm limit of finite ranks — the two facts his steps 5 and 6 produce, citing Prop 12.2.2.2 and the estimates of Thm 10.3.2.1 (txt 29991-30031). Stated rather than argued":
  forall k: StratumIndex; forall f: TestFunction;
  haar.inducesATraceClassFiniteRankLimit(theStratumIndentedKernel(k, f)) ->
  (inducesAContinuousOperator(theIndentedStratumKernel(k, f), thePaleyWienerLevel) and
  isTheNuclearLimitOfFiniteRanks(
  operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
  thePaleyWienerLevel))

/// The orbital integral EQUALS that operator's trace. This is the other half of what
/// THE ORBITAL INTEGRAL IS THE TRACE — DERIVED from the Haar-integration shim rather than
/// assumed. Prop 12.2.2.2 identifies a diagonal kernel integral with the iterated integral
/// of its indentation; the manuscript's step (txt 29991-30008) reads the orbital integral as
/// the former and the operator trace as the latter. With the shim stating that identity, this
/// becomes a substitution the kernel checks.
///
/// WHAT MOVED AND WHAT DID NOT. This was a BARE hole — a transcription task, since the
/// manuscript proves Prop 12.2.2.2 at txt 30775-30998. It is now a theorem over
/// `standard/haar-integration.b4m`, whose own content is a single `standard:` citation to
/// classical quotient-measure theory (Folland, Hewitt-Ross, Bourbaki). What remains ours is
/// only the two READINGS below: that the manuscript's sum-over-xi integral is a diagonal
/// integral in 12.2.2.2's sense, and that the nuclear trace is the iterated one. Those are
/// his identifications of the two settings, so they are `assertion:`.
///
/// Net: one transcription task becomes one classical citation plus two located assertions.

/// the stratum's kernel, viewed as a quotient kernel in Prop 12.2.2.2's sense
oper theStratumQuotientKernel(k: StratumIndex, f: TestFunction) => haar.QuotientKernel
/// the ambient group and discrete subgroup of the §11.3 setting
const theIdeleClassGroup: haar.LcaGroup
const theRationalLattice: haar.DiscreteSubgroup

hole thePropositionsHypothesesHold
  cites "assertion: that the manuscript's §11.3 setting satisfies Situation 12.2.2.1, carries an indentation (his u_0 of (11.3.2.2)), and has almost every diagonal point regular with an absolutely integrable diagonal, is what applying Prop 12.2.2.2 at txt 29991-30008 presumes. He applies it without restating the hypotheses":
  forall k: StratumIndex; forall f: TestFunction;
  haar.satisfiesSituation(theIdeleClassGroup, theRationalLattice) and
  haar.hasAnIndentation(theIdeleClassGroup, theRationalLattice) and
  haar.almostEveryDiagonalPointIsRegular(theStratumQuotientKernel(k, f)) and
  haar.theDiagonalIsAbsolutelyIntegrable(theStratumQuotientKernel(k, f))

hole theOrbitalIntegralAndTraceAreTheTwoSides
  cites "assertion: the manuscript equates the orbital integral with Prop 12.2.2.2's diagonal integral and the nuclear operator's trace with its iterated integral — 'the value (11.3.2.3) equals the value of the trace of the nuclear operator on W_I^s(C_F) which is the unique continuous extension that the kernel induces' (txt 29991-30008). Those two readings are his identification of the two settings, stated rather than argued":
  forall k: StratumIndex; forall f: TestFunction;
  inducesAContinuousOperator(theIndentedStratumKernel(k, f), thePaleyWienerLevel) ->
  isNuclearOn(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
  thePaleyWienerLevel) ->
  (theOrbitalIntegral(k, f) = haar.theDiagonalIntegral(theStratumQuotientKernel(k, f)) and
  trace(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
  thePaleyWienerLevel) =
  haar.theIteratedIndentedIntegral(
  haar.theIndentation(theStratumQuotientKernel(k, f), theIdeleClassGroup,
  theRationalLattice)))

intheory theOrbitalIntegralIsTheTrace

/// Strategy: get Prop 12.2.2.2's hypotheses, apply the shim for diagonal = iterated, read
/// both sides into the manuscript's names, and substitute.
theorem theOrbitalIntegralIsTheTrace:
  forall k: StratumIndex; forall f: TestFunction;
  inducesAContinuousOperator(theIndentedStratumKernel(k, f), thePaleyWienerLevel) ->
  isNuclearOn(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
  thePaleyWienerLevel) ->
  theOrbitalIntegral(k, f) =
  trace(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
  thePaleyWienerLevel)
proof
  @generalize-k |
    fix k: StratumIndex {
      @generalize-f |
        fix f: TestFunction {
          @given-induces |
            assume inducesAContinuousOperator(theIndentedStratumKernel(k, f),
              thePaleyWienerLevel) {
              @induces |
                inducesAContinuousOperator(theIndentedStratumKernel(k, f),
                  thePaleyWienerLevel)
                [by hypothesis given-induces]
              @given-nuclear |
                assume isNuclearOn(
                  operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
                  thePaleyWienerLevel) {
                  @nuclear |
                    isNuclearOn(
                      operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
                      thePaleyWienerLevel)
                    [by hypothesis given-nuclear]
                  @the-hypotheses-hold |
                    haar.satisfiesSituation(theIdeleClassGroup, theRationalLattice) and
                      haar.hasAnIndentation(theIdeleClassGroup, theRationalLattice) and
                      haar.almostEveryDiagonalPointIsRegular(
                      theStratumQuotientKernel(k, f)) and
                      haar.theDiagonalIsAbsolutelyIntegrable(
                      theStratumQuotientKernel(k, f))
                    [using specialize thePropositionsHypothesesHold(k, f)]
                  @situation |
                    haar.satisfiesSituation(theIdeleClassGroup, theRationalLattice)
                    [using tautology the-hypotheses-hold]
                  @indentation |
                    haar.hasAnIndentation(theIdeleClassGroup, theRationalLattice)
                    [using tautology the-hypotheses-hold]
                  @regular |
                    haar.almostEveryDiagonalPointIsRegular(
                      theStratumQuotientKernel(k, f))
                    [using tautology the-hypotheses-hold]
                  @integrable |
                    haar.theDiagonalIsAbsolutelyIntegrable(
                      theStratumQuotientKernel(k, f))
                    [using tautology the-hypotheses-hold]
                  // THE SHIM: Prop 12.2.2.2's conclusion, cited to classical measure theory
                  @diagonal-is-iterated |
                    haar.theDiagonalIntegral(theStratumQuotientKernel(k, f)) =
                      haar.theIteratedIndentedIntegral(
                      haar.theIndentation(theStratumQuotientKernel(k, f),
                      theIdeleClassGroup, theRationalLattice))
                    [using specialize theDiagonalIntegralIsTheIteratedIntegral(
                      theStratumQuotientKernel(k, f), theIdeleClassGroup,
                      theRationalLattice) situation indentation regular integrable]
                  @the-two-readings |
                    theOrbitalIntegral(k, f) =
                      haar.theDiagonalIntegral(theStratumQuotientKernel(k, f)) and
                      trace(operatorOf(theIndentedStratumKernel(k, f),
                      thePaleyWienerLevel), thePaleyWienerLevel) =
                      haar.theIteratedIndentedIntegral(
                      haar.theIndentation(theStratumQuotientKernel(k, f),
                      theIdeleClassGroup, theRationalLattice))
                    [using specialize theOrbitalIntegralAndTraceAreTheTwoSides(k, f)
                      induces nuclear]
                  @orbital-is-diagonal |
                    theOrbitalIntegral(k, f) =
                      haar.theDiagonalIntegral(theStratumQuotientKernel(k, f))
                    [by and_lhs the-two-readings]
                  @trace-is-iterated |
                    trace(operatorOf(theIndentedStratumKernel(k, f),
                      thePaleyWienerLevel), thePaleyWienerLevel) =
                      haar.theIteratedIndentedIntegral(
                      haar.theIndentation(theStratumQuotientKernel(k, f),
                      theIdeleClassGroup, theRationalLattice))
                    [by and_rhs the-two-readings]
                  @orbital-is-iterated |
                    theOrbitalIntegral(k, f) =
                      haar.theIteratedIndentedIntegral(
                      haar.theIndentation(theStratumQuotientKernel(k, f),
                      theIdeleClassGroup, theRationalLattice))
                    [by rewrite diagonal-is-iterated orbital-is-diagonal]
                  @conclusion-the-integral-is-the-trace |
                    theOrbitalIntegral(k, f) =
                      trace(operatorOf(theIndentedStratumKernel(k, f),
                      thePaleyWienerLevel), thePaleyWienerLevel)
                    [by rewrite trace-is-iterated orbital-is-iterated]
                }
              @nuclear-implies-the-identity |
                isNuclearOn(
                  operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
                  thePaleyWienerLevel) ->
                  theOrbitalIntegral(k, f) =
                  trace(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
                  thePaleyWienerLevel)
                [by discharge given-nuclear]
            }
          @induces-implies-the-identity |
            inducesAContinuousOperator(theIndentedStratumKernel(k, f),
              thePaleyWienerLevel) ->
              (isNuclearOn(
              operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
              thePaleyWienerLevel) ->
              theOrbitalIntegral(k, f) =
              trace(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
              thePaleyWienerLevel))
            [by discharge given-induces]
        }
      @discharge-f |
        forall f: TestFunction;
          inducesAContinuousOperator(theIndentedStratumKernel(k, f),
          thePaleyWienerLevel) ->
          (isNuclearOn(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
          thePaleyWienerLevel) ->
          theOrbitalIntegral(k, f) =
          trace(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
          thePaleyWienerLevel))
        [by generalize generalize-f]
    }
  @conclusion |
    forall k: StratumIndex; forall f: TestFunction;
      inducesAContinuousOperator(theIndentedStratumKernel(k, f), thePaleyWienerLevel) ->
      (isNuclearOn(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
      thePaleyWienerLevel) ->
      theOrbitalIntegral(k, f) =
      trace(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
      thePaleyWienerLevel))
    [by generalize generalize-k]
qed

// ---------------------------------------------------------------------------------------
// STEP 7: the limit value, and Poisson summation.
// ---------------------------------------------------------------------------------------

/// THE LIMIT VALUE IS THE ZERO SIDE — derived over Lidskii's theorem. "which, as lambda' is
/// large enough and for Lambda -> +infty in the regime eps*Lambda = o(1), attains the limit
/// value (11.3.2.5) which is the right side of (7.4.2.1) from Theorem 7.4.2.1"
/// (txt 30025-30033).
///
/// Thm 7.4.2.1 computes Trace(A_geom) as a sum over the zeros eps_p of a local Euler factor
/// product. That a nuclear operator's trace IS its spectral sum is classical (Lidskii), so
/// what the manuscript contributes is the IDENTIFICATION of the spectrum — that the
/// eigenvalues are indexed by those zeros with their multiplicities. That identification is
/// his, and stays an assertion.

hole theSpectrumIsIndexedByTheEulerZeros
  cites "assertion: Thm 7.4.2.1 (txt 22028-22033) states Trace(A_geom,p,chi(phi)) as a sum over the complex numbers eps_p for which chi|.|^{eps_p} is a zero of the local Euler factor product, with multiplicity N(chi|.|^{eps_p}). That his convolution operator's spectrum IS that zero set is the content of his theorem, not of Lidskii's; he states the resulting formula rather than exhibiting the spectral decomposition":
  forall k: StratumIndex; forall f: TestFunction;
  isNuclearOn(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
  thePaleyWienerLevel) ->
  haar.theSpectralSum(
  operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel)) =
  theZeroSideValue(f)

intheory theLimitValueIsTheZeroSide

/// Strategy: Lidskii gives trace = spectral sum; the manuscript's identification gives
/// spectral sum = the zero side; substitute.
theorem theLimitValueIsTheZeroSide:
  forall k: StratumIndex; forall f: TestFunction;
  inducesAContinuousOperator(theIndentedStratumKernel(k, f), thePaleyWienerLevel) ->
  (isNuclearOn(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel) ->
  trace(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel) = theZeroSideValue(f))
proof
  @generalize-k |
    fix k: StratumIndex {
      @generalize-f |
        fix f: TestFunction {
          @given-induces |
            assume inducesAContinuousOperator(theIndentedStratumKernel(k, f),
              thePaleyWienerLevel) {
              @induces |
                inducesAContinuousOperator(theIndentedStratumKernel(k, f),
                  thePaleyWienerLevel)
                [by hypothesis given-induces]
              @given-nuclear |
                assume isNuclearOn(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel) {
                  @nuclear |
                    isNuclearOn(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel)
                    [by hypothesis given-nuclear]
                  @lidskii-here |
                    hasAnAbsolutelySummableSpectrum(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel)) and
                      trace(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel) = haar.theSpectralSum(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel))
                    [using specialize theTraceIsTheSpectralSum(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
                      thePaleyWienerLevel) nuclear]
                  @trace-is-the-spectral-sum |
                    trace(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel) = haar.theSpectralSum(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel))
                    [by and_rhs lidskii-here]
                  @spectral-sum-is-the-zero-side |
                    haar.theSpectralSum(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel)) = theZeroSideValue(f)
                    [using specialize theSpectrumIsIndexedByTheEulerZeros(k, f)
                      induces nuclear]
                  @conclusion-the-trace-is-the-zero-side |
                    trace(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel) = theZeroSideValue(f)
                    [by rewrite spectral-sum-is-the-zero-side trace-is-the-spectral-sum]
                }
              @nuclear-implies-the-zero-side |
                isNuclearOn(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel) ->
                  trace(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel) = theZeroSideValue(f)
                [by discharge given-nuclear]
            }
          @induces-implies-the-zero-side |
            inducesAContinuousOperator(theIndentedStratumKernel(k, f),
              thePaleyWienerLevel) ->
              (isNuclearOn(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel) ->
              trace(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel) = theZeroSideValue(f))
            [by discharge given-induces]
        }
      @discharge-f |
        forall f: TestFunction;
          inducesAContinuousOperator(theIndentedStratumKernel(k, f),
          thePaleyWienerLevel) ->
          (isNuclearOn(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel) ->
          trace(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel) = theZeroSideValue(f))
        [by generalize generalize-f]
    }
  @conclusion |
    forall k: StratumIndex; forall f: TestFunction;
      inducesAContinuousOperator(theIndentedStratumKernel(k, f), thePaleyWienerLevel) ->
      (isNuclearOn(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel) ->
      trace(operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel), thePaleyWienerLevel) = theZeroSideValue(f))
    [by generalize generalize-k]
qed

/// Poisson summation converts the zero side into the local Euler contribution. "The Theorem
/// follows from the Poisson Summation Formula (see Proposition B.4.1.2)" (txt 30035).
hole poissonSummationGivesTheEulerContribution
  cites "standard: the Poisson summation formula in the jump-singularity form — Tate's thesis §4; Weil, Basic Number Theory §VII; Iwaniec-Kowalski, Analytic Number Theory §4.3. The manuscript collects it as Prop B.4.1.2 in an appendix titled 'Preparations'":
  forall f: TestFunction; forall k: StratumIndex;
  contributesAtStratum(k, f) ->
  theZeroSideValue(f) = theLocalEulerContribution(k, f)

// ---------------------------------------------------------------------------------------
// THE THEOREM. Chains the seven steps. This is 11.3.2.1's own skeleton, kernel-checked:
// the ASSEMBLY is verified even though each analytic input is cited.
// ---------------------------------------------------------------------------------------

/// Theorem 11.3.2.1 (Orbital Traces on the Paley-Wiener Levels), txt 29947.
/// Strategy: walk the manuscript's chain — vanishing, indicator preservation, convergence,
/// nuclearity, finite-rank limit, the zero-side value, then Poisson summation.
theorem theOrbitalTraceIsTheEulerContribution:
  forall f: TestFunction; forall s: PlaceSet; forall k: StratumIndex;
  isAdmissibleForOrbitalTraces(s, f) -> isSupportedAboveOne(f) ->
  theOrbitalIntegral(k, f) = theLocalEulerContribution(k, f)
proof
  @generalize-f |
    fix f: TestFunction {
      @generalize-s |
        fix s: PlaceSet {
          @generalize-k |
            fix k: StratumIndex {
              @given-s-is-admissible |
                assume isAdmissibleForOrbitalTraces(s, f) {
                  @given-phi-is-supported-above-one |
                    assume isSupportedAboveOne(f) {
                      @s-is-admissible |
                        isAdmissibleForOrbitalTraces(s, f)
                        [by hypothesis given-s-is-admissible]
                      @phi-is-supported-above-one |
                        isSupportedAboveOne(f)
                        [by hypothesis given-phi-is-supported-above-one]
                      // steps 1-3: the support bookkeeping
                      @the-kernel-contributes-only-at-the-stratum |
                        contributesAtStratum(k, f)
                        [using specialize theIndentedKernelVanishesOffTheStratum(k, f, s)
                          s-is-admissible phi-is-supported-above-one]
                      @the-indicator-preserves-the-value |
                        indicatorPreservesTheValue(k, f)
                        [using specialize theStratumIndicatorPreservesTheValue(k, f)
                          the-kernel-contributes-only-at-the-stratum]
                      // steps 4-6, collapsed: his three cited results specialize one
                      // classical nuclearity theorem, stated in haar-integration.b4m
                      @the-kernel-sequence-converges |
                        haar.kernelSequenceConverges(theStratumIndentedKernel(k, f))
                        [using specialize theManuscriptSettingIsNuclear(k, f)
                          the-indicator-preserves-the-value]
                      @the-kernel-is-trace-class |
                        haar.inducesATraceClassFiniteRankLimit(
                          theStratumIndentedKernel(k, f))
                        [using specialize convergentKernelsAreTraceClassFiniteRankLimits(
                          theStratumIndentedKernel(k, f)) the-kernel-sequence-converges]
                      @the-operator-facts |
                        inducesAContinuousOperator(theIndentedStratumKernel(k, f),
                          thePaleyWienerLevel) and
                          isTheNuclearLimitOfFiniteRanks(
                          operatorOf(theIndentedStratumKernel(k, f),
                          thePaleyWienerLevel), thePaleyWienerLevel)
                        [using specialize theShimConclusionGivesTheOperatorFacts(k, f)
                          the-kernel-is-trace-class]
                      @the-kernel-induces-an-operator |
                        inducesAContinuousOperator(theIndentedStratumKernel(k, f),
                          thePaleyWienerLevel)
                        [by and_lhs the-operator-facts]
                      @the-operator-is-a-finite-rank-limit |
                        isTheNuclearLimitOfFiniteRanks(
                          operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
                          thePaleyWienerLevel)
                        [by and_rhs the-operator-facts]
                      @the-operator-is-nuclear |
                        isNuclearOn(
                          operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
                          thePaleyWienerLevel)
                        [using specialize nuclearLimitsAreNuclear(
                          operatorOf(theIndentedStratumKernel(k, f), thePaleyWienerLevel),
                          thePaleyWienerLevel) the-operator-is-a-finite-rank-limit]
                      // step 7: the limit value, then Poisson summation
                      @the-trace-is-the-zero-side |
                        trace(operatorOf(theIndentedStratumKernel(k, f),
                          thePaleyWienerLevel), thePaleyWienerLevel) = theZeroSideValue(f)
                        [using specialize theLimitValueIsTheZeroSide(k, f)
                          the-kernel-induces-an-operator the-operator-is-nuclear]
                      @the-zero-side-is-the-euler-contribution |
                        theZeroSideValue(f) = theLocalEulerContribution(k, f)
                        [using specialize poissonSummationGivesTheEulerContribution(f, k)
                          the-kernel-contributes-only-at-the-stratum]
                      @the-integral-is-the-trace |
                        theOrbitalIntegral(k, f) =
                          trace(operatorOf(theIndentedStratumKernel(k, f),
                          thePaleyWienerLevel), thePaleyWienerLevel)
                        [using specialize theOrbitalIntegralIsTheTrace(k, f)
                          the-kernel-induces-an-operator the-operator-is-nuclear]
                      @the-integral-is-the-zero-side |
                        theOrbitalIntegral(k, f) = theZeroSideValue(f)
                        [by rewrite the-trace-is-the-zero-side the-integral-is-the-trace]
                      @conclusion-the-orbital-trace |
                        theOrbitalIntegral(k, f) = theLocalEulerContribution(k, f)
                        [by rewrite the-zero-side-is-the-euler-contribution
                          the-integral-is-the-zero-side]
                    }
                  @supported-implies-the-trace-value |
                    isSupportedAboveOne(f) ->
                      theOrbitalIntegral(k, f) = theLocalEulerContribution(k, f)
                    [by discharge given-phi-is-supported-above-one]
                }
              @admissible-implies-the-trace-value |
                isAdmissibleForOrbitalTraces(s, f) -> isSupportedAboveOne(f) ->
                  theOrbitalIntegral(k, f) = theLocalEulerContribution(k, f)
                [by discharge given-s-is-admissible]
            }
          @discharge-k |
            forall k: StratumIndex;
              isAdmissibleForOrbitalTraces(s, f) -> isSupportedAboveOne(f) ->
              theOrbitalIntegral(k, f) = theLocalEulerContribution(k, f)
            [by generalize generalize-k]
        }
      @discharge-s |
        forall s: PlaceSet; forall k: StratumIndex;
          isAdmissibleForOrbitalTraces(s, f) -> isSupportedAboveOne(f) ->
          theOrbitalIntegral(k, f) = theLocalEulerContribution(k, f)
        [by generalize generalize-s]
    }
  @conclusion |
    forall f: TestFunction; forall s: PlaceSet; forall k: StratumIndex;
      isAdmissibleForOrbitalTraces(s, f) -> isSupportedAboveOne(f) ->
      theOrbitalIntegral(k, f) = theLocalEulerContribution(k, f)
    [by generalize generalize-f]
qed
