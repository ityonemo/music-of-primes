// The `standard:` tier for ALGEBRAIC NUMBER THEORY — the manuscript's Appendix A,
// "Preparations from Algebraic Number Theory" (pp. 537-586). Classical material the author
// collected for the reader's convenience, not his contribution.
//
// Each result is cited to a real source, because a `cites` a reader cannot check is just an
// axiom wearing a comment. A citation is a POSITION, not a permanent verdict: any of these
// can be formalized later on its own schedule, and nothing downstream changes when it is.
// All of them stay visible in `--axioms`.

theory vocab <<< "../shared/vocabulary.b4m"

/// S is a finite set of places of F
sort PlaceSet = vocab.PlaceSet

/// the S-class group is trivial: Pic(O_{F,S}) = 1
pred hasTrivialSClassGroup(s: PlaceSet)
/// S contains every Archimedean place, every place ramified over Q, and every place where
/// the character chi ramifies
pred containsTheRamifiedAndArchimedeanPlaces(s: PlaceSet)

intheory enlargingSKillsTheClassGroup

/// Enlarging S trivializes the S-class group. Because Pic(O_F) is FINITE (class number h_F),
/// adjoining one place from each of the finitely many ideal classes kills it — the standard
/// argument, and the reason the manuscript may always "let S be large enough".
///
/// The manuscript uses this throughout (txt 1902, 5359, 7441) and states the S-unit lattice
/// estimates it needs as Theorem A.4.1.1.
hole aLargeEnoughSHasTrivialClassGroup
  cites "standard: finiteness of the ideal class group, hence Pic(O_{F,S}) = 1 once S meets every ideal class — Neukirch, Algebraic Number Theory I §6 and §12; Cassels-Frohlich Ch. II. Manuscript uses it at txt 1902, 5359, 7441; its S-unit estimates are Thm A.4.1.1":
  forall s: PlaceSet;
  containsTheRamifiedAndArchimedeanPlaces(s) -> hasTrivialSClassGroup(s)

/// A finite set of places meeting the three ramification/Archimedean conditions exists:
/// there are finitely many Archimedean places, finitely many ramified over Q, and finitely
/// many where chi ramifies, so their union is finite.
hole theRequiredPlacesAreFinitelyMany
  cites "standard: a number field has finitely many Archimedean places and finitely many ramified primes; a Hecke character ramifies at finitely many — Neukirch I §8, III §2; Tate's thesis §2":
  exists s: PlaceSet; containsTheRamifiedAndArchimedeanPlaces(s)

theorem enlargingSKillsTheClassGroup:
  exists s: PlaceSet; containsTheRamifiedAndArchimedeanPlaces(s) and hasTrivialSClassGroup(s)
proof
  @some-s |
    exists s: PlaceSet; containsTheRamifiedAndArchimedeanPlaces(s)
    [by cite theRequiredPlacesAreFinitelyMany]
  @build |
    unpack s: PlaceSet from some-s {
      @has-places |
        containsTheRamifiedAndArchimedeanPlaces(s)
        [by hypothesis build]
      @trivializes-all |
        forall t: PlaceSet;
          containsTheRamifiedAndArchimedeanPlaces(t) -> hasTrivialSClassGroup(t)
        [by cite aLargeEnoughSHasTrivialClassGroup]
      @trivializes-at-s |
        containsTheRamifiedAndArchimedeanPlaces(s) -> hasTrivialSClassGroup(s)
        [by apply_at(s) trivializes-all]
      @trivial |
        hasTrivialSClassGroup(s)
        [by modus_ponens trivializes-at-s has-places]
      @both |
        containsTheRamifiedAndArchimedeanPlaces(s) and hasTrivialSClassGroup(s)
        [by both has-places trivial]
      @witness |
        exists t: PlaceSet; containsTheRamifiedAndArchimedeanPlaces(t) and hasTrivialSClassGroup(t)
        [by witness(s) both]
    }
  @conclusion |
    exists s: PlaceSet; containsTheRamifiedAndArchimedeanPlaces(s) and hasTrivialSClassGroup(s)
    [by unpacked build]
qed

// ---------------------------------------------------------------------------------------
// WHY S CAN ALWAYS BE ENLARGED — the two classical facts behind "assume S is so large that…"
// ---------------------------------------------------------------------------------------

sort TestFunction = vocab.TestFunction

/// the absolute norms N(p_v) of the prime ideals grow without bound, so only finitely many
/// places have N(p_v) below any given threshold
pred primeNormsAreUnbounded()
/// a test function has COMPACT support, so its support meets only finitely many places
/// non-trivially
pred compactSupportMeetsFinitelyManyPlaces(f: TestFunction)

intheory onlyFinitelyManyPlacesObstruct

/// The absolute norms of prime ideals are unbounded: for any T there are only finitely many
/// primes with N(p) <= T. Classical — it is why the manuscript may always "assume S is large
/// enough so as to arrange that the support K of phi satisfies |K|_F subset (1/T, T) with
/// T < N(p_v) for every finite place v not in S".
hole thePrimeNormsAreUnbounded
  cites "standard: only finitely many prime ideals have absolute norm below a bound (the ideal-counting function is finite) — Neukirch, Algebraic Number Theory I §6 Prop 6.1; Lang, Algebraic Number Theory V §1. Used by the manuscript at txt 31541":
  primeNormsAreUnbounded()

/// A test function is compactly supported, so its support meets only finitely many places
/// non-trivially — which is why enlarging S finitely many times suffices to absorb both the
/// support condition and the invariance condition.
hole compactSupportIsFinitelySupported
  cites "standard: a compactly supported function on a restricted product meets only finitely many factors non-trivially — Weil, Basic Number Theory IV §1; Tate's thesis §3.1. Used by the manuscript at txt 31543 for the invariance condition":
  forall f: TestFunction; compactSupportMeetsFinitelyManyPlaces(f)

theorem onlyFinitelyManyPlacesObstruct:
  primeNormsAreUnbounded() and
  (forall f: TestFunction; compactSupportMeetsFinitelyManyPlaces(f))
proof
  @norms |
    primeNormsAreUnbounded()
    [by cite thePrimeNormsAreUnbounded]
  @support |
    forall f: TestFunction; compactSupportMeetsFinitelyManyPlaces(f)
    [by cite compactSupportIsFinitelySupported]
  @conclusion |
    primeNormsAreUnbounded() and
      (forall f: TestFunction; compactSupportMeetsFinitelyManyPlaces(f))
    [by both norms support]
qed
