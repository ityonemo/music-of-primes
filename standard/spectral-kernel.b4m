// Definition 10.4.3.7 (Global Spectral and Geometric Kernels) + Theorem 10.4.2.8 (Spectral
// side: convolution after projection), DECOMPOSED.
//
// WHY THIS FILE EXISTS. These two were bundled into one bare hole
// (`theSpectralSideIsTheKernelIntegral`) in `trace-formula.b4m`. The manuscript's own
// sentence separates them: equation (12.5.1.4) holds "by DESIGN of the global geometric
// kernel (see Definition 10.4.3.7) and by Theorem 10.4.2.8" (txt 31569). So one half is a
// DEFINITION and the other is a theorem, and they deserve different treatment:
//
//   Def 10.4.3.7 is two equations (txt 28655-28670):
//       k_spec(x,y) := k(x,y) * w_{I,s}(y)^{-1}
//       k_geom(x,y) := phi(x y^{-1}) - k_spec(x,y)
//     The second is pure algebra. It is written here as a DEFINITION BLOCK, so the kernel
//     verifies the rearrangement rather than assuming it — `k_spec = phi - k_geom` is then a
//     checked consequence, not a hole.
//
//   Thm 10.4.2.8 is the analysis (txt 27947-28130): Trace(M_rho A(phi) P_a^spec) =
//     Trace(A_a^spec(phi)) + o(1), proved via a Markushevich basis lift, S1 = S2 norm
//     identity, and an estimate of (10.4.2.26) in the regime eps*Lambda = o(1).
//
// WHAT THIS BUYS. The algebraic half becomes kernel-checked; only the analytic half stays
// cited. That is the deepening move: the bundled hole hid a definition inside it.
//
// ALTITUDE: opaque. `Weight` and `Kernel` carry no structure; `sub` on Quantity is the one
// algebraic operation, declared here with the laws the rearrangement needs.

theory vocab <<< "../shared/vocabulary.b4m"
theory operator_theory <<< "operator-theory.b4m"

sort TestFunction = vocab.TestFunction
sort Quantity = vocab.Quantity

sort Operator = operator_theory.Operator
sort HardySobolevSpace = operator_theory.HardySobolevSpace
pred isNuclearOn = operator_theory.isNuclearOn
oper trace = operator_theory.trace

// ---------------------------------------------------------------------------------------
// Definition 10.4.3.7 — the two kernels, and the algebra relating them.
// ---------------------------------------------------------------------------------------

/// a point of C_F x C_F, where the kernels are evaluated
sort KernelPoint

/// the value k(x,y) of the ambient kernel at a point
oper theAmbientKernelValue(p: KernelPoint, f: TestFunction) => Quantity
/// the weight factor w_{I,s}(y)^{-1} of (9.2.2.41)
oper theInverseWeight(p: KernelPoint) => Quantity
/// the convolution value phi(x y^{-1})
oper theConvolutionValue(p: KernelPoint, f: TestFunction) => Quantity

/// multiplication of quantities, for the weight factor
oper mul(a: Quantity, b: Quantity) => Quantity
/// subtraction of quantities, for the geometric-minus-spectral relation
oper sub(a: Quantity, b: Quantity) => Quantity

/// The Global SPECTRAL Kernel, (10.4.3.49): k_spec(x,y) := k(x,y) w_{I,s}(y)^{-1}.
/// A DEFINITION, exactly as the manuscript writes it.
oper theSpectralKernelValue(p: KernelPoint, f: TestFunction) => Quantity:
  theSpectralKernelValue(p, f) =
  mul(theAmbientKernelValue(p, f), theInverseWeight(p)).

/// The Global GEOMETRIC Kernel, (10.4.3.50): k_geom(x,y) := phi(x y^{-1}) - k_spec(x,y).
/// A DEFINITION, exactly as the manuscript writes it.
oper theGeometricKernelValue(p: KernelPoint, f: TestFunction) => Quantity:
  theGeometricKernelValue(p, f) =
  sub(theConvolutionValue(p, f), theSpectralKernelValue(p, f)).

intheory theSpectralKernelIsTheConvolutionMinusTheGeometric

// ---------------------------------------------------------------------------------------
// The one algebraic law the rearrangement needs. `Quantity` is opaque, so it is stated.
// ---------------------------------------------------------------------------------------

/// a - (a - b) = b. Standard in any abelian group; `Quantity` carries no structure here.
hole subtractionUndoesItself
  cites "standard: a - (a - b) = b in any abelian group — immediate from associativity, commutativity and inverses. `Quantity` is opaque in this encoding, so the law is stated rather than derived":
  forall a: Quantity; forall b: Quantity; sub(a, sub(a, b)) = b

/// The spectral kernel is the convolution value minus the geometric one. This is the
/// REARRANGEMENT of Definition 10.4.3.7(2), and it is what (12.5.1.4) uses: the manuscript
/// says that equation holds "by design of the global geometric kernel". Kernel-checked from
/// the definition plus one group law, rather than assumed.
theorem theSpectralKernelIsTheConvolutionMinusTheGeometric:
  forall p: KernelPoint; forall f: TestFunction;
  theSpectralKernelValue(p, f) =
  sub(theConvolutionValue(p, f), theGeometricKernelValue(p, f))
proof
  @the-geometric-kernel-definition |
    forall q: KernelPoint; forall g: TestFunction;
      theGeometricKernelValue(q, g) =
      sub(theConvolutionValue(q, g), theSpectralKernelValue(q, g))
    [by definition(0) theGeometricKernelValue]
  @generalize-p |
    fix p: KernelPoint {
      @generalize-f |
        fix f: TestFunction {
          @the-geometric-kernel-unfolds |
            theGeometricKernelValue(p, f) =
              sub(theConvolutionValue(p, f), theSpectralKernelValue(p, f))
            [by apply_at(p, f) the-geometric-kernel-definition]
          @subtraction-undoes-itself-here |
            sub(theConvolutionValue(p, f),
              sub(theConvolutionValue(p, f), theSpectralKernelValue(p, f))) =
              theSpectralKernelValue(p, f)
            [using specialize subtractionUndoesItself(theConvolutionValue(p, f),
              theSpectralKernelValue(p, f))]
          @substitute-the-geometric-kernel |
            sub(theConvolutionValue(p, f), theGeometricKernelValue(p, f)) =
              theSpectralKernelValue(p, f)
            [by rewrite the-geometric-kernel-unfolds subtraction-undoes-itself-here]
          @conclusion-the-spectral-kernel |
            theSpectralKernelValue(p, f) =
              sub(theConvolutionValue(p, f), theGeometricKernelValue(p, f))
            [by symmetry substitute-the-geometric-kernel]
        }
      @discharge-f |
        forall f: TestFunction;
          theSpectralKernelValue(p, f) =
          sub(theConvolutionValue(p, f), theGeometricKernelValue(p, f))
        [by generalize generalize-f]
    }
  @conclusion |
    forall p: KernelPoint; forall f: TestFunction;
      theSpectralKernelValue(p, f) =
      sub(theConvolutionValue(p, f), theGeometricKernelValue(p, f))
    [by generalize generalize-p]
qed

// ---------------------------------------------------------------------------------------
// Theorem 10.4.2.8 — the analytic half. Cited, not transcribed.
// ---------------------------------------------------------------------------------------

/// the spectral projection P_a^spec, and the nuclear operator A_a^spec(phi) of (10.3.2.2)
oper theProjectedConvolution(f: TestFunction) => Operator
oper theSpectralOperator(f: TestFunction) => Operator
/// the ambient space on which both act
const theSpectralLevel: HardySobolevSpace

/// THEOREM 10.4.2.8 — derived over Lidskii's theorem. "Trace(M_rho o A(phi) o P_a^spec) =
/// Trace(A_a^spec(phi)) + o(1) as Lambda -> +infinity" (txt 27950), in the regime
/// eps*Lambda = o(1).
///
/// Both operators are nuclear, so each trace IS its spectral sum (Lidskii, classical). The
/// manuscript's content is therefore that the two SPECTRA agree in the limit — which is what
/// his ~180-line proof establishes, by lifting a Spectral Markushevich basis (Thm 10.2.2.1),
/// using the S1 = S2 norm identity for finite-rank operators (he cites Conway Ch.3 §18
/// Thm 18.13), and estimating the integral (10.4.2.26).
///
/// So this splits as: Lidskii twice, cited; the spectral agreement, his assertion.

theory haar <<< "haar-integration.b4m"
fact theTraceIsTheSpectralSum = haar.theTraceIsTheSpectralSum
pred hasAnAbsolutelySummableSpectrum = haar.hasAnAbsolutelySummableSpectrum

hole theTwoSpectraAgreeInTheLimit
  cites "assertion: Thm 10.4.2.8's content is that the projected convolution and the spectral operator have the same spectral sum in the limit regime eps*Lambda = o(1) — his proof (txt 27950-28130) establishes it via a Markushevich basis lift and an estimate of (10.4.2.26), and states the conclusion with an o(1) term rather than exhibiting the two spectra as equal. Reading the o(1) comparison as an equality of spectral sums is this encoding's simplification, since no asymptotics are modelled at this altitude":
  forall f: TestFunction;
  haar.theSpectralSum(theProjectedConvolution(f)) =
  haar.theSpectralSum(theSpectralOperator(f))

intheory theProjectedTraceIsTheSpectralTrace

/// Strategy: Lidskii on each operator, then the manuscript's spectral agreement, then
/// substitute both ways.
theorem theProjectedTraceIsTheSpectralTrace:
  forall f: TestFunction;
  isNuclearOn(theProjectedConvolution(f), theSpectralLevel) ->
  (isNuclearOn(theSpectralOperator(f), theSpectralLevel) ->
  trace(theProjectedConvolution(f), theSpectralLevel) =
  trace(theSpectralOperator(f), theSpectralLevel))
proof
  @generalize-f |
    fix f: TestFunction {
      @given-projected-nuclear |
        assume isNuclearOn(theProjectedConvolution(f), theSpectralLevel) {
          @projected-nuclear |
            isNuclearOn(theProjectedConvolution(f), theSpectralLevel)
            [by hypothesis given-projected-nuclear]
          @given-spectral-nuclear |
            assume isNuclearOn(theSpectralOperator(f), theSpectralLevel) {
              @spectral-nuclear |
                isNuclearOn(theSpectralOperator(f), theSpectralLevel)
                [by hypothesis given-spectral-nuclear]
              @lidskii-projected |
                hasAnAbsolutelySummableSpectrum(theProjectedConvolution(f)) and
                  trace(theProjectedConvolution(f), theSpectralLevel) =
                  haar.theSpectralSum(theProjectedConvolution(f))
                [using specialize theTraceIsTheSpectralSum(theProjectedConvolution(f),
                  theSpectralLevel) projected-nuclear]
              @projected-trace-is-its-spectral-sum |
                trace(theProjectedConvolution(f), theSpectralLevel) =
                  haar.theSpectralSum(theProjectedConvolution(f))
                [by and_rhs lidskii-projected]
              @lidskii-spectral |
                hasAnAbsolutelySummableSpectrum(theSpectralOperator(f)) and
                  trace(theSpectralOperator(f), theSpectralLevel) =
                  haar.theSpectralSum(theSpectralOperator(f))
                [using specialize theTraceIsTheSpectralSum(theSpectralOperator(f),
                  theSpectralLevel) spectral-nuclear]
              @spectral-trace-is-its-spectral-sum |
                trace(theSpectralOperator(f), theSpectralLevel) =
                  haar.theSpectralSum(theSpectralOperator(f))
                [by and_rhs lidskii-spectral]
              @the-spectra-agree |
                haar.theSpectralSum(theProjectedConvolution(f)) =
                  haar.theSpectralSum(theSpectralOperator(f))
                [using specialize theTwoSpectraAgreeInTheLimit(f)]
              @projected-trace-is-the-spectral-sum |
                trace(theProjectedConvolution(f), theSpectralLevel) =
                  haar.theSpectralSum(theSpectralOperator(f))
                [by rewrite the-spectra-agree projected-trace-is-its-spectral-sum]
              @conclusion-the-traces-agree |
                trace(theProjectedConvolution(f), theSpectralLevel) =
                  trace(theSpectralOperator(f), theSpectralLevel)
                [by rewrite spectral-trace-is-its-spectral-sum
                  projected-trace-is-the-spectral-sum]
            }
          @spectral-nuclear-implies-agreement |
            isNuclearOn(theSpectralOperator(f), theSpectralLevel) ->
              trace(theProjectedConvolution(f), theSpectralLevel) =
              trace(theSpectralOperator(f), theSpectralLevel)
            [by discharge given-spectral-nuclear]
        }
      @projected-nuclear-implies-agreement |
        isNuclearOn(theProjectedConvolution(f), theSpectralLevel) ->
          (isNuclearOn(theSpectralOperator(f), theSpectralLevel) ->
          trace(theProjectedConvolution(f), theSpectralLevel) =
          trace(theSpectralOperator(f), theSpectralLevel))
        [by discharge given-projected-nuclear]
    }
  @conclusion |
    forall f: TestFunction;
      isNuclearOn(theProjectedConvolution(f), theSpectralLevel) ->
      (isNuclearOn(theSpectralOperator(f), theSpectralLevel) ->
      trace(theProjectedConvolution(f), theSpectralLevel) =
      trace(theSpectralOperator(f), theSpectralLevel))
    [by generalize generalize-f]
qed
