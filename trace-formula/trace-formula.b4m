// Theorem 12.5.1.1 (Trace Formula), p. 519 — the manuscript's declared main theorem, and
// the result the whole GRH deduction runs on.
//
// This file CLOSES the `theTraceFormula` hole in grh.b4m by replacing it with the
// manuscript's own proof skeleton. The proof (txt lines 31539-31567) is:
//
//   1. choose S finite, containing the Archimedean places, the places ramified over Q, the
//      places where chi ramifies, with Pic(O_{F,S}) = 1 and S large enough that phi's
//      support and invariance behave;
//   2. decompose the smoothened geometric kernel along the diagonal      — eq (11.3.1.4)
//   3. the off-S terms vanish                                           — Thm 11.3.2.1
//   4. the S-local integral IS the left side of (12.5.1.1)              — Thm 12.4.1.1
//   5. the global kernel integral IS the spectral side                  — Def 10.4.3.7
//                                                                       + Thm 10.4.2.8
//   6. combine.
//
// Each of 2-5 is PROVED in the manuscript, so each is a BARE hole: ours to transcribe, and
// the frontier has moved one layer down. Nothing here is assumed on the author's behalf.

theory vocab <<< "../shared/vocabulary.b4m"
theory ant <<< "../standard/algebraic-number-theory.b4m"
theory classical <<< "../standard/analysis.b4m"
theory orbital <<< "../standard/orbital-traces.b4m"
theory slocal <<< "../standard/s-local-trace.b4m"
theory spectral <<< "../standard/spectral-kernel.b4m"

// shared with grh.b4m: the objects and the Trace Formula predicate itself
sort TestFunction = vocab.TestFunction
sort PlaceSet = vocab.PlaceSet
pred isTestFunction = vocab.isTestFunction
pred vanishesOnTheNormOneIdeles = vocab.vanishesOnTheNormOneIdeles

// LOCAL to this layer: the proof's internal stages. Nothing else needs them, so they are
// declared here rather than in the shared vocabulary.
//
// The proof's first paragraph asks THREE things of S, and they are not of the same kind, so
// they are not bundled: the first two are classical facts about number fields, the third is
// a condition on phi that the manuscript arranges by enlarging S.
pred containsTheRamifiedAndArchimedeanPlaces = ant.containsTheRamifiedAndArchimedeanPlaces
pred hasTrivialSClassGroup = ant.hasTrivialSClassGroup

/// S is large enough for THIS phi: its support satisfies |K|_F subset (1/T, T) with
/// T < N(p_v) for every finite v outside S, and phi is invariant under the left-translation
/// action of the image of prod_{v notin S} O_{F_v}^times.
pred isLargeEnoughFor(s: PlaceSet, f: TestFunction)

/// all three conditions together — what the rest of the proof uses
pred isAdmissibleFor(s: PlaceSet, f: TestFunction):
  isAdmissibleFor(s, f) iff
  ((containsTheRamifiedAndArchimedeanPlaces(s) and hasTrivialSClassGroup(s))
  and isLargeEnoughFor(s, f)).

// The proof's quantities, as TERMS rather than opaque booleans. The last step of the
// manuscript's proof ("Upon combining (12.5.1.4) with the foregoing") is a SUBSTITUTION
// between equations about the same integral, so modelling these as predicates would have
// made that step unprovable-by-construction — an opaque `combine` hole standing in for
// arithmetic the kernel can actually do. With terms it is `rewrite`.
sort Quantity = vocab.Quantity
oper theGeometricSide = vocab.theGeometricSide
oper theSpectralSide = vocab.theSpectralSide
pred theTraceFormulaHoldsAt = vocab.theTraceFormulaHoldsAt

/// \int_{C_F} k(x,x) dmu — the global kernel integral along the diagonal
oper theGlobalIntegral(f: TestFunction) => Quantity
/// \int_{C_F} k_S(x,x) dmu — its S-local part
oper theSLocalIntegral(s: PlaceSet, f: TestFunction) => Quantity
/// the sum of the off-S pieces, \sum_{p nmid S} \int k_p(x,x) dmu
oper theOffSPieces(s: PlaceSet, f: TestFunction) => Quantity

oper add(a: Quantity, b: Quantity) => Quantity
const noQuantity: Quantity // 0
intheory theTraceFormula

// ---------------------------------------------------------------------------------------
// OURS TO TRANSCRIBE — each proved in the manuscript. Bare holes: strict check rejects
// them, so they stay on the worklist.
// ---------------------------------------------------------------------------------------

// SPLIT. "Assume S is so large that…" asks two things of phi: its support satisfies
// |K|_F subset (1/T, T) with T < N(p_v) outside S, and phi is invariant under the units
// outside S. Both are possible because of two CLASSICAL facts, now cited in
// standard/algebraic-number-theory.b4m:
//
//   only finitely many primes have norm below a bound   (Neukirch I §6 Prop 6.1)
//   a compactly supported function meets finitely many places   (Weil BNT IV §1)
//
// Together they say: only finitely many places obstruct, so finitely many enlargements
// suffice. What remains OURS is that enlarging preserves the first two conditions while
// achieving these — the manuscript's own bookkeeping about its filtration and conventions.
pred primeNormsAreUnbounded = ant.primeNormsAreUnbounded
pred compactSupportMeetsFinitelyManyPlaces = ant.compactSupportMeetsFinitelyManyPlaces
fact onlyFinitelyManyPlacesObstruct = ant.onlyFinitelyManyPlacesObstruct

hole finitelyManyEnlargementsSuffice
  cites "assertion: the manuscript ASSUMES this rather than proving it — 'We further assume S is large enough so as to arrange that the support K of phi satisfies |K|_F subset (1/T, T)...' and 'Further assume that S is so large that phi is invariant under...' (txt 31541-31543). Plausible, and the classical half (only finitely many places obstruct) is cited separately; but the preservation of the earlier conditions under enlargement is asserted":
  forall f: TestFunction;
  (primeNormsAreUnbounded() and compactSupportMeetsFinitelyManyPlaces(f)) ->
  forall s: PlaceSet;
  isTestFunction(f) ->
  (containsTheRamifiedAndArchimedeanPlaces(s) and hasTrivialSClassGroup(s)) ->
  exists t: PlaceSet;
  (containsTheRamifiedAndArchimedeanPlaces(t) and hasTrivialSClassGroup(t))
  and isLargeEnoughFor(t, f)

// SPLIT. Equation (11.3.1.4) is a DEFINITION — it defines k_{p_k} as the successive
// difference (alpha_{k+1} - alpha_k) * k_geom — and the Trace Formula's proof then integrates
// term by term and sums. So the step has two parts, of different kinds:
//
//   CLASSICAL, cited — countable additivity of the Haar integral over a partition
//                      (standard/analysis.b4m). That IS the content of "integrate the pieces
//                      and sum".
//   OURS, below      — that the alpha_k indicators of the divisorial filtration really do
//                      PARTITION the ideles, a fact about the manuscript's filtration rather
//                      than about integration.
sort Locus = classical.Locus
pred partitionsTheDomain = classical.partitionsTheDomain
pred integralIsAdditiveOver = classical.integralIsAdditiveOver
fact countableAdditivity = classical.countableAdditivity

/// the locus the alpha_k strata carve out, for a given S and phi
oper theFiltrationStrata(s: PlaceSet, f: TestFunction) => Locus

sort IndexSet = classical.IndexSet
pred splitsIntoTwoParts = classical.splitsIntoTwoParts
pred sumRegroupsOverTheSplit = classical.sumRegroupsOverTheSplit
fact sumsRegroupOverAPartitionedIndex = classical.sumsRegroupOverAPartitionedIndex

/// the index set of the strata, for a given S and phi
oper theStrataIndex(s: PlaceSet, f: TestFunction) => IndexSet

/// MICRO-HOLE, closed rather than parked. The manuscript says "By (11.3.1.4), this reads:"
/// and writes `int k_S + sum_{p nmid S} int k_p = int k` with no argument (txt 31551). The
/// content is an INDEX REGROUPING: the strata indexed by k >= 0 split into those whose places
/// all lie in S (bundled as the single k_S term) and those involving a prime outside S (one
/// k_p each). Regrouping an absolutely convergent sum over a partition is CLASSICAL and is
/// cited; what remains is only that the index set does split that way, which is reading the
/// definition of S.
hole theStrataIndexSplitsAtS cites
  "assertion: the author's single sentence at txt 31551 ('By (11.3.1.4), this reads:') asserts both that the strata index splits into the places-inside-S part and the one-prime-outside-S part, and that regrouping along that split yields the kernel shape. This is the first half — a claim about his own admissibility construction, which he does not argue":
  forall f: TestFunction; forall s: PlaceSet;
  isAdmissibleFor(s, f) -> splitsIntoTwoParts(theStrataIndex(s, f))

/// and that the regrouped sum IS the S-local-plus-off-S shape
hole theRegroupedSumIsTheKernelSplit cites
  "assertion: the author writes the regrouped identity 'int k_S dmu + sum_{p nmid S} int k_p dmu = int k dmu' with no argument, citing (11.3.1.4) (txt 31551). The regrouping itself is cited to Rudin/Halmos; this is the remaining claim that the regrouped shape IS the S-local-plus-off-S split":
  forall f: TestFunction; forall s: PlaceSet;
  integralIsAdditiveOver(theFiltrationStrata(s, f)) ->
  sumRegroupsOverTheSplit(theStrataIndex(s, f)) ->
  theGlobalIntegral(f) = add(theSLocalIntegral(s, f), theOffSPieces(s, f))

/// SPLIT. The manuscript's strata are the PREIMAGES under the norm map
/// GL_1(A_F) -> GL_1(A_Q) of the divisorial strata on GL_1(A_Q), with the P_k nested and
/// exhausting by construction (txt 1166-1169). So partitioning has two halves:
///
///   CLASSICAL, cited — successive differences of a nested exhaustion are disjoint and
///                      cover, and a preimage of a partition is a partition (set theory).
///   OURS, below      — that the P_k ARE nested and exhausting, which is a claim about the
///                      manuscript's construction (saturation, finest refinement).
pred isANestedExhaustion = classical.isANestedExhaustion
pred successiveDifferencesPartition = classical.successiveDifferencesPartition
fact nestedExhaustionsPartition = classical.nestedExhaustionsPartition

sort IndexedFamily = classical.IndexedFamily
pred isTheInitialSegmentFamily = classical.isTheInitialSegmentFamily
pred nestsAndExhausts = classical.nestsAndExhausts
fact initialSegmentsNestAndExhaust = classical.initialSegmentsNestAndExhaust

/// the T_k family underlying the strata: "the finite set of the first k rational primes"
oper theRationalPrimeSegments(s: PlaceSet, f: TestFunction) => IndexedFamily

/// CLOSED, not assumed. The manuscript DEFINES T_k as the first k rational primes
/// (txt 1169) and P_k as its preimage under |Spec(O_F)| -> |Spec(Z)|, so nesting is by
/// construction — there is no proof in the paper because none is needed. What this file
/// still owes is only the IDENTIFICATION: that the strata really are built from the initial
/// segments that way, which is reading the manuscript's own definition.
hole theStrataAreBuiltFromInitialSegments
  cites "assertion: the manuscript's own word is ASSUME — 'we will term the primary divisorial stratification the stratification {GL_1(A_F)_{P_k}} ... where we assume: (1) S is saturated. (2) Each P_k is saturated, and obtained as a union of finitely many of the T_m. (3) {P_k} is the finest among such stratifications' (txt 1158-1163). It then says 'more directly, we define P_k to be the pre-image ... of T_k', T_k being the first k rational primes (txt 1169)":
  forall f: TestFunction; forall s: PlaceSet;
  isAdmissibleFor(s, f) ->
  isTheInitialSegmentFamily(theRationalPrimeSegments(s, f))

/// and that nesting of the segments transfers to the strata (preimage under the norm map)
hole segmentNestingLiftsToTheStrata
  cites "assertion: that the T_k nesting transfers to the strata through the norm-map preimage is stated as the construction, not argued — 'the stratum GL_1(A_F)_{P_k} is the pre-image under the norm map GL_1(A_F) -> GL_1(A_Q) of the kth divisorial stratum' (txt 1164-1174)":
  forall f: TestFunction; forall s: PlaceSet;
  nestsAndExhausts(theRationalPrimeSegments(s, f)) ->
  isANestedExhaustion(theFiltrationStrata(s, f))

// Theorem 11.3.2.1 (Orbital Traces on the Paley-Wiener Levels), txt 29947. DECOMPOSED in
// `standard/orbital-traces.b4m` into the manuscript's own seven-step chain, so what was one
// opaque hole is now a kernel-checked assembly over located, cited inputs.
//
// The manuscript's use here is per-prime: "by Theorem 11.3.2.1, each int_{C_F} k_p(x,x)
// dmu(x) = 0 for all prime numbers p that are not the prime residue characteristic of any
// finite place contained in S" (txt 31556). Two steps remain between that and the SUM over
// p nmid S vanishing, both recorded below.

/// S's admissibility here supplies 11.3.2.1's hypotheses (Archimedean + ramified places,
/// Pic(O_{F,S}) = 1, phi invariant under prod_{v not in S} O_Fv^x, phi supported over C_F^{>1}).
hole admissibilityGives11321Hypotheses
  cites "assertion: `isAdmissibleFor` here bundles the conditions 11.3.2.1 lists separately (txt 29947-29957). The manuscript uses one S throughout §12.5.1 without restating them at the point of application":
  forall f: TestFunction; forall s: PlaceSet;
  isAdmissibleFor(s, f) ->
  (orbital.isAdmissibleForOrbitalTraces(s, f) and orbital.isSupportedAboveOne(f))

/// For a prime p outside S the LOCAL EULER CONTRIBUTION vanishes: phi is invariant under
/// prod_{v not in S} O_Fv^x, so sum_{k in Z} phi(pi_v^k) contributes nothing at such a place.
/// This is the half of txt 31556 that is NOT 11.3.2.1 — the vanishing of its right side.
hole theOffSEulerContributionVanishes
  cites "assertion: txt 31556 applies 11.3.2.1 and concludes 'each int k_p(x,x) dmu(x) = 0 for all prime numbers p that are not the prime residue characteristic of any finite place contained in S' in one move. 11.3.2.1 supplies the EQUALITY of the integral with the local Euler contribution; that the contribution itself vanishes off S follows from phi's invariance under prod_{v not in S} O_Fv^x, which the author does not write out":
  forall f: TestFunction; forall s: PlaceSet; forall k: orbital.StratumIndex;
  isAdmissibleFor(s, f) ->
  orbital.theLocalEulerContribution(k, f) = noQuantity

/// and that every off-S orbital integral vanishing makes their SUM vanish.
hole aSumOfVanishingPiecesVanishes
  cites "standard: a convergent sum all of whose terms are zero is zero — immediate from the definition of a sum as a limit of partial sums (Rudin, Principles of Mathematical Analysis Thm 3.1, 3.55 for the regrouped form). `Quantity` is opaque here, so the one fact the step needs is stated":
  forall f: TestFunction; forall s: PlaceSet;
  (forall k: orbital.StratumIndex; orbital.theOrbitalIntegral(k, f) = noQuantity) ->
  theOffSPieces(s, f) = noQuantity

fact theOrbitalTraceIsTheEulerContribution =
  orbital.theOrbitalTraceIsTheEulerContribution

intheory theOrbitalTracesVanishOffS

/// The off-S pieces contribute nothing. Strategy: 11.3.2.1 (decomposed) gives each stratum's
/// orbital trace as its Euler contribution; off S that contribution vanishes; a sum of zeros
/// is zero.
theorem theOrbitalTracesVanishOffS:
  forall f: TestFunction; forall s: PlaceSet;
  isAdmissibleFor(s, f) -> theOffSPieces(s, f) = noQuantity
proof
  @generalize-f |
    fix f: TestFunction {
      @generalize-s |
        fix s: PlaceSet {
          @given-s-is-admissible |
            assume isAdmissibleFor(s, f) {
              @s-is-admissible |
                isAdmissibleFor(s, f)
                [by hypothesis given-s-is-admissible]
              @the-11321-hypotheses-hold |
                orbital.isAdmissibleForOrbitalTraces(s, f) and
                  orbital.isSupportedAboveOne(f)
                [using specialize admissibilityGives11321Hypotheses(f, s)
                  s-is-admissible]
              @s-is-admissible-for-orbital-traces |
                orbital.isAdmissibleForOrbitalTraces(s, f)
                [by and_lhs the-11321-hypotheses-hold]
              @phi-is-supported-above-one |
                orbital.isSupportedAboveOne(f)
                [by and_rhs the-11321-hypotheses-hold]
              @generalize-k |
                fix k: orbital.StratumIndex {
                  // THE USE OF 11.3.2.1: the orbital integral IS the Euler contribution
                  @the-orbital-integral-is-the-euler-contribution |
                    orbital.theOrbitalIntegral(k, f) =
                      orbital.theLocalEulerContribution(k, f)
                    [using specialize theOrbitalTraceIsTheEulerContribution(f, s, k)
                      s-is-admissible-for-orbital-traces phi-is-supported-above-one]
                  @the-off-s-contribution-vanishes-at-k |
                    orbital.theLocalEulerContribution(k, f) = noQuantity
                    [using specialize theOffSEulerContributionVanishes(f, s, k)
                      s-is-admissible]
                  @the-orbital-integral-vanishes-at-k |
                    orbital.theOrbitalIntegral(k, f) = noQuantity
                    [by rewrite the-off-s-contribution-vanishes-at-k
                      the-orbital-integral-is-the-euler-contribution]
                }
              @every-off-s-orbital-integral-vanishes |
                forall k: orbital.StratumIndex;
                  orbital.theOrbitalIntegral(k, f) = noQuantity
                [by generalize generalize-k]
              @conclusion-the-off-s-pieces-vanish |
                theOffSPieces(s, f) = noQuantity
                [using specialize aSumOfVanishingPiecesVanishes(f, s)
                  every-off-s-orbital-integral-vanishes]
            }
          @admissible-implies-the-pieces-vanish |
            isAdmissibleFor(s, f) -> theOffSPieces(s, f) = noQuantity
            [by discharge given-s-is-admissible]
        }
      @discharge-s |
        forall s: PlaceSet;
          isAdmissibleFor(s, f) -> theOffSPieces(s, f) = noQuantity
        [by generalize generalize-s]
    }
  @conclusion |
    forall f: TestFunction; forall s: PlaceSet;
      isAdmissibleFor(s, f) -> theOffSPieces(s, f) = noQuantity
    [by generalize generalize-f]
qed

// Theorem 12.4.1.1 (S-local Trace calculation), txt 31123. DECOMPOSED in
// `standard/s-local-trace.b4m` into the manuscript's own seven-stage computation — which
// surfaced an incompleteness the author himself flags: his footnote 2 to that proof says the
// cutoff definition it uses must be EXTENDED and a convergence study is outstanding.
//
// Two steps remain between 12.4.1.1's conclusion and the form used here: that this file's
// admissibility implies the S-local file's, and that the local integral sum IS what
// `theGeometricSide` denotes.

/// this file's admissibility hypothesis supplies 12.4.1.1's
hole admissibilityIsSLocalAdmissibility
  cites "assertion: `isAdmissibleFor` here bundles the Archimedean/ramified/class-group conditions that 12.4.1.1 lists separately (txt 31123-31127). The two are the same hypothesis stated at different granularity; the manuscript uses one S throughout §12.5.1 without restating the conditions":
  forall f: TestFunction; forall s: PlaceSet;
  isAdmissibleFor(s, f) -> slocal.isSLocallyAdmissible(s, f)

/// and that the per-place local integral sum is the geometric side of (12.5.1.1)
hole theLocalIntegralSumIsTheGeometricSide
  cites "assertion: txt 31559 says 'By Theorem 12.4.1.1, we further have that int k_S(x,x) dmu(x) equals the left side of (12.5.1.1) upon ...' — the two Mellin terms are subtracted in that step, which this encoding folds into `theGeometricSide` rather than modelling. That the folded form is exactly 12.4.1.1's right side is the author's identification, not argued":
  forall f: TestFunction; forall s: PlaceSet;
  slocal.theSLocalKernelIntegral(s, f) = slocal.theLocalIntegralSum(s, f) ->
  theSLocalIntegral(s, f) = theGeometricSide(f)

fact theSLocalTraceIsTheLocalIntegralSum = slocal.theSLocalTraceIsTheLocalIntegralSum

intheory theSLocalTraceCalculation

/// The S-local integral is the geometric side. Strategy: transfer admissibility, apply the
/// decomposed 12.4.1.1, then identify its right side with `theGeometricSide`.
theorem theSLocalTraceCalculation:
  forall f: TestFunction; forall s: PlaceSet;
  isAdmissibleFor(s, f) -> theSLocalIntegral(s, f) = theGeometricSide(f)
proof
  @generalize-f |
    fix f: TestFunction {
      @generalize-s |
        fix s: PlaceSet {
          @given-s-is-admissible |
            assume isAdmissibleFor(s, f) {
              @s-is-admissible |
                isAdmissibleFor(s, f)
                [by hypothesis given-s-is-admissible]
              @s-is-s-locally-admissible |
                slocal.isSLocallyAdmissible(s, f)
                [using specialize admissibilityIsSLocalAdmissibility(f, s) s-is-admissible]
              @the-s-local-trace-is-the-local-integral-sum |
                slocal.theSLocalKernelIntegral(s, f) = slocal.theLocalIntegralSum(s, f)
                [using specialize theSLocalTraceIsTheLocalIntegralSum(s, f)
                  s-is-s-locally-admissible]
              @conclusion-the-s-local-integral |
                theSLocalIntegral(s, f) = theGeometricSide(f)
                [using specialize theLocalIntegralSumIsTheGeometricSide(f, s)
                  the-s-local-trace-is-the-local-integral-sum]
            }
          @admissible-implies-the-geometric-side |
            isAdmissibleFor(s, f) -> theSLocalIntegral(s, f) = theGeometricSide(f)
            [by discharge given-s-is-admissible]
        }
      @discharge-s |
        forall s: PlaceSet;
          isAdmissibleFor(s, f) -> theSLocalIntegral(s, f) = theGeometricSide(f)
        [by generalize generalize-s]
    }
  @conclusion |
    forall f: TestFunction; forall s: PlaceSet;
      isAdmissibleFor(s, f) -> theSLocalIntegral(s, f) = theGeometricSide(f)
    [by generalize generalize-f]
qed

// Definition 10.4.3.7 + Theorem 10.4.2.8, txt 28655 / 27947. DECOMPOSED in
// `standard/spectral-kernel.b4m`, which splits them the way the manuscript's own sentence
// does: (12.5.1.4) holds "by DESIGN of the global geometric kernel (see Definition 10.4.3.7)
// and by Theorem 10.4.2.8" (txt 31569).
//
// The DESIGN half — that k_spec = phi - k_geom — is now KERNEL-CHECKED there from the
// definition block plus one cited group law, rather than assumed. Only the analytic half
// (10.4.2.8's trace comparison) stays cited.
//
// What remains here is the identification of this file's global integral with that file's
// kernel algebra, which the manuscript performs in one line.

/// the diagonal point (x, x) at which the global kernel integral is evaluated
const theGlobalKernelPoint: spectral.KernelPoint

/// the global integral is the spectral kernel's trace, which (12.5.1.4) evaluates. The
/// kernel REARRANGEMENT this rests on is proved in `standard/spectral-kernel.b4m`.
hole theGlobalIntegralIsTheSpectralKernelValue
  cites "assertion: txt 31569 asserts (12.5.1.4) in one line, citing Def 10.4.3.7 for the kernel's design and Thm 10.4.2.8 for the trace. The design half is now kernel-checked (spectral-kernel.b4m's theSpectralKernelIsTheConvolutionMinusTheGeometric); this hole is the remaining identification of the global diagonal integral with that kernel algebra at a point, which the author does not write out":
  forall f: TestFunction; forall p: spectral.KernelPoint;
  isTestFunction(f) ->
  spectral.theSpectralKernelValue(p, f) =
  spectral.sub(spectral.theConvolutionValue(p, f),
  spectral.theGeometricKernelValue(p, f)) ->
  spectral.trace(spectral.theProjectedConvolution(f), spectral.theSpectralLevel) =
  spectral.trace(spectral.theSpectralOperator(f), spectral.theSpectralLevel) ->
  theGlobalIntegral(f) = theSpectralSide(f)

/// 10.4.2.8 needs both operators nuclear; this file's test-function hypothesis supplies it.
hole theSpectralOperatorsAreNuclear
  cites "assertion: Thm 10.4.2.8's statement (txt 27947) presumes the nuclearity its §10.3 predecessors establish (A_a^spec(phi) is 'the nuclear operator from (10.3.2.2)'); the author does not restate the hypothesis when applying it at txt 31569":
  forall f: TestFunction;
  isTestFunction(f) ->
  (spectral.isNuclearOn(spectral.theProjectedConvolution(f), spectral.theSpectralLevel) and
  spectral.isNuclearOn(spectral.theSpectralOperator(f), spectral.theSpectralLevel))

fact theSpectralKernelIsTheConvolutionMinusTheGeometric =
  spectral.theSpectralKernelIsTheConvolutionMinusTheGeometric
fact theProjectedTraceIsTheSpectralTrace =
  spectral.theProjectedTraceIsTheSpectralTrace

intheory theSpectralSideIsTheKernelIntegral

/// The global integral is the spectral side — equation (12.5.1.4). Strategy: take the
/// kernel-checked rearrangement of Def 10.4.3.7 at a point, then apply the author's
/// identification.
theorem theSpectralSideIsTheKernelIntegral:
  forall f: TestFunction;
  isTestFunction(f) -> theGlobalIntegral(f) = theSpectralSide(f)
proof
  @generalize-f |
    fix f: TestFunction {
      @given-phi-is-a-test-function |
        assume isTestFunction(f) {
          @phi-is-a-test-function |
            isTestFunction(f)
            [by hypothesis given-phi-is-a-test-function]
          @the-kernel-rearrangement |
            forall q: spectral.KernelPoint; forall g: TestFunction;
              spectral.theSpectralKernelValue(q, g) =
              spectral.sub(spectral.theConvolutionValue(q, g),
              spectral.theGeometricKernelValue(q, g))
            [by cite theSpectralKernelIsTheConvolutionMinusTheGeometric]
          @the-kernel-rearrangement-at-the-point |
            spectral.theSpectralKernelValue(theGlobalKernelPoint, f) =
              spectral.sub(spectral.theConvolutionValue(theGlobalKernelPoint, f),
              spectral.theGeometricKernelValue(theGlobalKernelPoint, f))
            [by apply_at(theGlobalKernelPoint, f) the-kernel-rearrangement]
          @the-spectral-operators-are-nuclear |
            spectral.isNuclearOn(spectral.theProjectedConvolution(f),
              spectral.theSpectralLevel) and
              spectral.isNuclearOn(spectral.theSpectralOperator(f),
              spectral.theSpectralLevel)
            [using specialize theSpectralOperatorsAreNuclear(f) phi-is-a-test-function]
          @the-projected-convolution-is-nuclear |
            spectral.isNuclearOn(spectral.theProjectedConvolution(f),
              spectral.theSpectralLevel)
            [by and_lhs the-spectral-operators-are-nuclear]
          @the-spectral-operator-is-nuclear |
            spectral.isNuclearOn(spectral.theSpectralOperator(f),
              spectral.theSpectralLevel)
            [by and_rhs the-spectral-operators-are-nuclear]
          // THE USE OF 10.4.2.8: the two traces agree
          @the-traces-agree |
            spectral.trace(spectral.theProjectedConvolution(f),
              spectral.theSpectralLevel) =
              spectral.trace(spectral.theSpectralOperator(f), spectral.theSpectralLevel)
            [using specialize theProjectedTraceIsTheSpectralTrace(f)
              the-projected-convolution-is-nuclear the-spectral-operator-is-nuclear]
          @conclusion-the-global-integral |
            theGlobalIntegral(f) = theSpectralSide(f)
            [using specialize theGlobalIntegralIsTheSpectralKernelValue(f,
              theGlobalKernelPoint)
              phi-is-a-test-function the-kernel-rearrangement-at-the-point
              the-traces-agree]
        }
      @test-function-implies-the-spectral-side |
        isTestFunction(f) -> theGlobalIntegral(f) = theSpectralSide(f)
        [by discharge given-phi-is-a-test-function]
    }
  @conclusion |
    forall f: TestFunction;
      isTestFunction(f) -> theGlobalIntegral(f) = theSpectralSide(f)
    [by generalize generalize-f]
qed

// Adding zero changes nothing. Standard in any additive structure; `Quantity` is opaque
// here, so the one algebraic fact the combination needs is stated rather than derived.
hole addingNothingChangesNothing
  cites "standard: x + 0 = x in any additive monoid — `Quantity` is opaque in this encoding, so its additive unit law is stated rather than built":
  forall q: Quantity; add(q, noQuantity) = q

// ---------------------------------------------------------------------------------------
// THE PROOF of Theorem 12.5.1.1. The final combination is now a real `rewrite` chain, not
// an opaque `combine` hole: three equations about the SAME integral, substituted.
// ---------------------------------------------------------------------------------------

theorem theTraceFormula: forall f: TestFunction;
  isTestFunction(f) -> vanishesOnTheNormOneIdeles(f) -> theTraceFormulaHoldsAt(f)
proof
  @generalize-phi |
    fix phi: TestFunction {
      @given-phi-is-a-test-function |
        assume isTestFunction(phi) {
          @given-phi-vanishes-on-the-norm-one-ideles |
            assume vanishesOnTheNormOneIdeles(phi) {
              @phi-is-a-test-function |
                isTestFunction(phi)
                [by hypothesis given-phi-is-a-test-function]

              // step 1: choose an admissible S. The CLASSICAL half is cited from
              // standard/algebraic-number-theory.b4m — a finite set meeting the
              // ramification conditions exists, and enlarging it trivializes the class
              // group. Only the phi-specific enlargement remains ours.
              @a-classical-s-exists |
                exists s: PlaceSet;
                  containsTheRamifiedAndArchimedeanPlaces(s) and hasTrivialSClassGroup(s)
                [using import(ant) enlargingSKillsTheClassGroup]
              @with-classical-place-set-s0 |
                unpack s0: PlaceSet from a-classical-s-exists {
                  @the-classical-s-has-its-properties |
                    containsTheRamifiedAndArchimedeanPlaces(s0) and hasTrivialSClassGroup(s0)
                    [by hypothesis with-classical-place-set-s0]
                  // the two CLASSICAL facts that make enlargement possible at all
                  @finitely-many-places-obstruct |
                    primeNormsAreUnbounded() and
                      (forall f: TestFunction; compactSupportMeetsFinitelyManyPlaces(f))
                    [using import(ant) onlyFinitelyManyPlacesObstruct]
                  @the-prime-norms-are-unbounded |
                    primeNormsAreUnbounded()
                    [by and_lhs finitely-many-places-obstruct]
                  @support-is-finite-for-every-test-function |
                    forall f: TestFunction; compactSupportMeetsFinitelyManyPlaces(f)
                    [by and_rhs finitely-many-places-obstruct]
                  @support-is-finite-for-phi |
                    compactSupportMeetsFinitelyManyPlaces(phi)
                    [by apply_at(phi) support-is-finite-for-every-test-function]
                  @the-two-classical-inputs |
                    primeNormsAreUnbounded() and compactSupportMeetsFinitelyManyPlaces(phi)
                    [by both the-prime-norms-are-unbounded support-is-finite-for-phi]
                  // OURS: finitely many enlargements suffice, preserving the first two conditions
                  @enlargement-suffices-for-every-test-function |
                    forall f: TestFunction;
                      (primeNormsAreUnbounded() and compactSupportMeetsFinitelyManyPlaces(f)) ->
                      forall t: PlaceSet;
                      isTestFunction(f) ->
                      (containsTheRamifiedAndArchimedeanPlaces(t) and hasTrivialSClassGroup(t)) ->
                      exists u: PlaceSet;
                      (containsTheRamifiedAndArchimedeanPlaces(u) and hasTrivialSClassGroup(u))
                      and isLargeEnoughFor(u, f)
                    [by cite finitelyManyEnlargementsSuffice]
                  @enlargement-suffices-for-phi |
                    (primeNormsAreUnbounded() and compactSupportMeetsFinitelyManyPlaces(phi)) ->
                      forall t: PlaceSet;
                      isTestFunction(phi) ->
                      (containsTheRamifiedAndArchimedeanPlaces(t) and hasTrivialSClassGroup(t)) ->
                      exists u: PlaceSet;
                      (containsTheRamifiedAndArchimedeanPlaces(u) and hasTrivialSClassGroup(u))
                      and isLargeEnoughFor(u, phi)
                    [by apply_at(phi) enlargement-suffices-for-every-test-function]
                  @enlargement-suffices-at-phi |
                    forall t: PlaceSet;
                      isTestFunction(phi) ->
                      (containsTheRamifiedAndArchimedeanPlaces(t) and hasTrivialSClassGroup(t)) ->
                      exists u: PlaceSet;
                      (containsTheRamifiedAndArchimedeanPlaces(u) and hasTrivialSClassGroup(u))
                      and isLargeEnoughFor(u, phi)
                    [by modus_ponens enlargement-suffices-for-phi the-two-classical-inputs]
                  @enlargement-suffices-at-the-classical-s |
                    isTestFunction(phi) ->
                      (containsTheRamifiedAndArchimedeanPlaces(s0) and hasTrivialSClassGroup(s0)) ->
                      exists u: PlaceSet;
                      (containsTheRamifiedAndArchimedeanPlaces(u) and hasTrivialSClassGroup(u))
                      and isLargeEnoughFor(u, phi)
                    [by apply_at(s0) enlargement-suffices-at-phi]
                  @enlargement-needs-the-classical-properties |
                    (containsTheRamifiedAndArchimedeanPlaces(s0) and hasTrivialSClassGroup(s0)) ->
                      exists u: PlaceSet;
                      (containsTheRamifiedAndArchimedeanPlaces(u) and hasTrivialSClassGroup(u))
                      and isLargeEnoughFor(u, phi)
                    [by modus_ponens enlargement-suffices-at-the-classical-s phi-is-a-test-function]
                  @an-admissible-enlargement-exists |
                    exists u: PlaceSet;
                      (containsTheRamifiedAndArchimedeanPlaces(u) and hasTrivialSClassGroup(u))
                      and isLargeEnoughFor(u, phi)
                    [by modus_ponens enlargement-needs-the-classical-properties the-classical-s-has-its-properties]
                  @conclusion-the-trace-formula-at-phi |
                    unpack s: PlaceSet from an-admissible-enlargement-exists {
                      @the-enlargement-has-its-properties |
                        (containsTheRamifiedAndArchimedeanPlaces(s) and hasTrivialSClassGroup(s))
                          and isLargeEnoughFor(s, phi)
                        [by hypothesis conclusion-the-trace-formula-at-phi]
                      @admissibility-unfolds |
                        forall t: PlaceSet; forall f: TestFunction;
                          isAdmissibleFor(t, f) iff
                          ((containsTheRamifiedAndArchimedeanPlaces(t) and hasTrivialSClassGroup(t))
                          and isLargeEnoughFor(t, f))
                        [by definition(0) isAdmissibleFor]
                      @admissibility-unfolds-at-s |
                        forall f: TestFunction;
                          isAdmissibleFor(s, f) iff
                          ((containsTheRamifiedAndArchimedeanPlaces(s) and hasTrivialSClassGroup(s))
                          and isLargeEnoughFor(s, f))
                        [by apply_at(s) admissibility-unfolds]
                      @admissibility-at-s-forward |
                        isAdmissibleFor(s, phi) iff
                          ((containsTheRamifiedAndArchimedeanPlaces(s) and hasTrivialSClassGroup(s))
                          and isLargeEnoughFor(s, phi))
                        [by apply_at(phi) admissibility-unfolds-at-s]
                      @admissibility-at-s-converse |
                        ((containsTheRamifiedAndArchimedeanPlaces(s) and hasTrivialSClassGroup(s))
                          and isLargeEnoughFor(s, phi)) -> isAdmissibleFor(s, phi)
                        [by equiv_converse admissibility-at-s-forward]
                      @s-admissible |
                        isAdmissibleFor(s, phi)
                        [by modus_ponens admissibility-at-s-converse the-enlargement-has-its-properties]

                      // step 2: the kernel decomposes. The alpha_k strata partition (OURS); additivity of
                      // the integral over a partition is CLASSICAL (cited); together they give the split.
                      // the P_k are nested + exhausting (OURS)
                      // the strata are built from the T_k initial segments (reading the definition)
                      @the-segments-are-initial-segments |
                        isTheInitialSegmentFamily(theRationalPrimeSegments(s, phi))
                        [using specialize theStrataAreBuiltFromInitialSegments(phi, s) s-admissible]
                      // initial segments nest and exhaust — DEFINITIONAL, cited
                      @initial-segments-nest-and-exhaust |
                        forall x: IndexedFamily;
                          isTheInitialSegmentFamily(x) -> nestsAndExhausts(x)
                        [by cite initialSegmentsNestAndExhaust]
                      @the-segments-nest-and-exhaust |
                        isTheInitialSegmentFamily(theRationalPrimeSegments(s, phi)) ->
                          nestsAndExhausts(theRationalPrimeSegments(s, phi))
                        [by apply_at(theRationalPrimeSegments(s, phi)) initial-segments-nest-and-exhaust]
                      @the-segments-nest |
                        nestsAndExhausts(theRationalPrimeSegments(s, phi))
                        [by modus_ponens the-segments-nest-and-exhaust the-segments-are-initial-segments]
                      // and that lifts to the strata through the norm-map preimage
                      @the-strata-are-nested |
                        isANestedExhaustion(theFiltrationStrata(s, phi))
                        [using specialize segmentNestingLiftsToTheStrata(phi, s) the-segments-nest]
                      // successive differences therefore partition (CLASSICAL, cited)
                      @nested-exhaustions-partition |
                        forall l: Locus; isANestedExhaustion(l) -> successiveDifferencesPartition(l)
                        [by cite nestedExhaustionsPartition]
                      @the-strata-differences-partition-pre |
                        isANestedExhaustion(theFiltrationStrata(s, phi)) ->
                          successiveDifferencesPartition(theFiltrationStrata(s, phi))
                        [by apply_at(theFiltrationStrata(s, phi)) nested-exhaustions-partition]
                      @the-strata-differences-partition |
                        successiveDifferencesPartition(theFiltrationStrata(s, phi))
                        [by modus_ponens the-strata-differences-partition-pre the-strata-are-nested]
                      // and `partitionsTheDomain` is DEFINED as exactly that, so unfold rather than glue
                      @partitioning-unfolds |
                        forall l: Locus;
                          partitionsTheDomain(l) iff successiveDifferencesPartition(l)
                        [using import(classical) definition(0) classical.partitionsTheDomain]
                      @partitioning-unfolds-at-the-strata |
                        partitionsTheDomain(theFiltrationStrata(s, phi)) iff
                          successiveDifferencesPartition(theFiltrationStrata(s, phi))
                        [by apply_at(theFiltrationStrata(s, phi)) partitioning-unfolds]
                      @partitioning-unfolds-converse |
                        successiveDifferencesPartition(theFiltrationStrata(s, phi)) ->
                          partitionsTheDomain(theFiltrationStrata(s, phi))
                        [by equiv_converse partitioning-unfolds-at-the-strata]
                      @the-strata-partition-the-domain |
                        partitionsTheDomain(theFiltrationStrata(s, phi))
                        [by modus_ponens partitioning-unfolds-converse the-strata-differences-partition]
                      @the-integral-is-countably-additive |
                        forall l: Locus; partitionsTheDomain(l) -> integralIsAdditiveOver(l)
                        [by cite countableAdditivity]
                      @additivity-at-the-strata |
                        partitionsTheDomain(theFiltrationStrata(s, phi)) ->
                          integralIsAdditiveOver(theFiltrationStrata(s, phi))
                        [by apply_at(theFiltrationStrata(s, phi)) the-integral-is-countably-additive]
                      @the-integral-is-additive-over-the-strata |
                        integralIsAdditiveOver(theFiltrationStrata(s, phi))
                        [by modus_ponens additivity-at-the-strata the-strata-partition-the-domain]
                      // the strata index splits at S (reading S's definition)
                      @the-strata-index-splits-at-s |
                        splitsIntoTwoParts(theStrataIndex(s, phi))
                        [using specialize theStrataIndexSplitsAtS(phi, s) s-admissible]
                      // regrouping over a split index is CLASSICAL, cited
                      @sums-regroup-over-a-partitioned-index |
                        forall i: IndexSet;
                          splitsIntoTwoParts(i) -> sumRegroupsOverTheSplit(i)
                        [by cite sumsRegroupOverAPartitionedIndex]
                      @sums-regroup-at-the-strata-index |
                        splitsIntoTwoParts(theStrataIndex(s, phi)) ->
                          sumRegroupsOverTheSplit(theStrataIndex(s, phi))
                        [by apply_at(theStrataIndex(s, phi)) sums-regroup-over-a-partitioned-index]
                      @the-strata-sum-regroups |
                        sumRegroupsOverTheSplit(theStrataIndex(s, phi))
                        [by modus_ponens sums-regroup-at-the-strata-index the-strata-index-splits-at-s]
                      // the manuscript's assertion: that regrouping yields exactly this equation
                      @the-integral-splits-at-s |
                        theGlobalIntegral(phi) = add(theSLocalIntegral(s, phi), theOffSPieces(s, phi))
                        [using specialize theRegroupedSumIsTheKernelSplit(phi, s) the-integral-is-additive-over-the-strata the-strata-sum-regroups]

                      // step 3: the off-S pieces vanish (Thm 11.3.2.1)
                      @the-off-s-pieces-vanish |
                        theOffSPieces(s, phi) = noQuantity
                        [using specialize theOrbitalTracesVanishOffS(phi, s) s-admissible]

                      // step 4: the S-local calculation (Thm 12.4.1.1)
                      @the-s-local-piece-is-the-geometric-side |
                        theSLocalIntegral(s, phi) = theGeometricSide(phi)
                        [using specialize theSLocalTraceCalculation(phi, s) s-admissible]

                      // step 5: the spectral side (Def 10.4.3.7 + Thm 10.4.2.8), eq (12.5.1.4)
                      @the-global-integral-is-the-spectral-side |
                        theGlobalIntegral(phi) = theSpectralSide(phi)
                        [using specialize theSpectralSideIsTheKernelIntegral(phi) phi-is-a-test-function]

                      // step 6: COMBINE. Substitute the vanishing and the unit law into the
                      // the-integral-splits-at-s to get global = geometric, then chain with (12.5.1.4).
                      @adding-nothing-changes-nothing |
                        forall q: Quantity; add(q, noQuantity) = q
                        [by cite addingNothingChangesNothing]
                      @adding-nothing-to-the-geometric-side |
                        add(theGeometricSide(phi), noQuantity) = theGeometricSide(phi)
                        [by apply_at(theGeometricSide(phi)) adding-nothing-changes-nothing]
                      @the-split-with-the-geometric-side |
                        theGlobalIntegral(phi) = add(theGeometricSide(phi), theOffSPieces(s, phi))
                        [by rewrite the-s-local-piece-is-the-geometric-side the-integral-splits-at-s]
                      @the-split-with-the-vanishing-off-s-part |
                        theGlobalIntegral(phi) = add(theGeometricSide(phi), noQuantity)
                        [by rewrite the-off-s-pieces-vanish the-split-with-the-geometric-side]
                      @the-spectral-side-is-the-geometric-side |
                        theGlobalIntegral(phi) = theGeometricSide(phi)
                        [by rewrite adding-nothing-to-the-geometric-side the-split-with-the-vanishing-off-s-part]
                      @the-geometric-side-is-the-spectral-side |
                        theGeometricSide(phi) = theGlobalIntegral(phi)
                        [by symmetry the-spectral-side-is-the-geometric-side]
                      @conclusion-the-two-sides-agree |
                        theGeometricSide(phi) = theSpectralSide(phi)
                        [by rewrite the-global-integral-is-the-spectral-side the-geometric-side-is-the-spectral-side]
                    }
                  // export past the inner `unpack s` (the witness is gone from the statement)
                  @the-two-sides-agree-at-the-classical-s |
                    theGeometricSide(phi) = theSpectralSide(phi)
                    [by unpacked conclusion-the-trace-formula-at-phi]
                }
              // and past the outer `unpack s0`
              @the-two-sides-agree |
                theGeometricSide(phi) = theSpectralSide(phi)
                [by unpacked with-classical-place-set-s0]
              // `theTraceFormulaHoldsAt` is DEFINED as this equality, so the consumer-facing
              // statement follows by unfolding the definition.
              @the-trace-formula-unfolds |
                forall f: TestFunction;
                  theTraceFormulaHoldsAt(f) iff theGeometricSide(f) = theSpectralSide(f)
                [using import(vocab) definition(0) vocab.theTraceFormulaHoldsAt]
              @the-trace-formula-unfolds-at-phi |
                theTraceFormulaHoldsAt(phi) iff theGeometricSide(phi) = theSpectralSide(phi)
                [by apply_at(phi) the-trace-formula-unfolds]
              @the-trace-formula-unfolds-converse |
                theGeometricSide(phi) = theSpectralSide(phi) -> theTraceFormulaHoldsAt(phi)
                [by equiv_converse the-trace-formula-unfolds-at-phi]
              @the-trace-formula-holds-at-phi |
                theTraceFormulaHoldsAt(phi)
                [by modus_ponens the-trace-formula-unfolds-converse the-two-sides-agree]
            }
          @vanishing-implies-the-trace-formula |
            vanishesOnTheNormOneIdeles(phi) -> theTraceFormulaHoldsAt(phi)
            [by discharge given-phi-vanishes-on-the-norm-one-ideles]
        }
      @test-function-implies-the-trace-formula |
        isTestFunction(phi) -> vanishesOnTheNormOneIdeles(phi) -> theTraceFormulaHoldsAt(phi)
        [by discharge given-phi-is-a-test-function]
    }
  @conclusion |
    forall f: TestFunction;
      isTestFunction(f) -> vanishesOnTheNormOneIdeles(f) -> theTraceFormulaHoldsAt(f)
    [by generalize generalize-phi]
qed
