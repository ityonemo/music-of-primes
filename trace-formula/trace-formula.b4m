// Theorem 12.5.1.1 (Trace Formula), p. 519 — the manuscript's declared main theorem, and
// the result the whole GRH deduction runs on.
//
// This file CLOSES the `theTraceFormula` hole in grh.b4m by replacing it with the
// manuscript's own proof skeleton. The proof (txt lines 31539-31567) is:
//
//   1. choose S finite, containing the Archimedean places, the places ramified over Q, the
//      places where chi ramifies, with Pic(O_{F,S}) = 1 and S large enough that phi's
//      support and invariance behave;
//   2. decompose the smoothened geometric kernel along the diagonal      — eq (11.3.1.4)
//   3. the off-S terms vanish                                           — Thm 11.3.2.1
//   4. the S-local integral IS the left side of (12.5.1.1)              — Thm 12.4.1.1
//   5. the global kernel integral IS the spectral side                  — Def 10.4.3.7
//                                                                       + Thm 10.4.2.8
//   6. combine.
//
// Each of 2-5 is PROVED in the manuscript, so each is a BARE hole: ours to transcribe, and
// the frontier has moved one layer down. Nothing here is assumed on the author's behalf.

theory vocab <<< "../shared/vocabulary.b4m"

// shared with grh.b4m: the objects and the Trace Formula predicate itself
sort TestFunction = vocab.TestFunction
sort PlaceSet = vocab.PlaceSet
pred isTestFunction = vocab.isTestFunction
pred vanishesOnTheNormOneIdeles = vocab.vanishesOnTheNormOneIdeles
pred theTraceFormulaHoldsAt = vocab.theTraceFormulaHoldsAt

// LOCAL to this layer: the proof's internal stages. Nothing else needs them, so they are
// declared here rather than in the shared vocabulary.
//
// S is admissible for phi in the sense of the proof's first paragraph: it contains the
// Archimedean places, those ramified over Q and those where chi ramifies, has trivial
// S-class group, and is large enough for phi's support and invariance.
pred isAdmissibleFor(s: PlaceSet, f: TestFunction)

// the kernel decomposition of (11.3.1.4): global = S-local + the off-S pieces
pred theKernelDecomposes(s: PlaceSet, f: TestFunction)
// each off-S piece integrates to zero
pred theOffSPiecesVanish(s: PlaceSet, f: TestFunction)
// the S-local integral equals the GEOMETRIC side of (12.5.1.1)
pred theSLocalIntegralIsTheGeometricSide(s: PlaceSet, f: TestFunction)
// the global kernel integral equals the SPECTRAL side, eq (12.5.1.4)
pred theGlobalIntegralIsTheSpectralSide(f: TestFunction)
intheory theTraceFormula

// ---------------------------------------------------------------------------------------
// OURS TO TRANSCRIBE — each proved in the manuscript. Bare holes: strict check rejects
// them, so they stay on the worklist.
// ---------------------------------------------------------------------------------------

// The proof's opening move. Existence of an admissible S is asserted by construction
// ("We let S be a finite set of places containing…"); it rests on Dirichlet's S-unit
// theorem and finiteness of the class group, both in Appendix A.
hole anAdmissibleSetOfPlacesExists:
  forall f: TestFunction;
    isTestFunction(f) -> exists s: PlaceSet; isAdmissibleFor(s, f)

// Equation (11.3.1.4): the smoothened geometric kernel splits along the diagonal into its
// S-local part plus one piece per prime not dividing S.
hole theGeometricKernelDecomposition:
  forall f: TestFunction; forall s: PlaceSet;
    isAdmissibleFor(s, f) -> theKernelDecomposes(s, f)

// Theorem 11.3.2.1 (Orbital Traces on the Paley-Wiener Levels), txt line 29947 — proved.
// Gives that each off-S piece integrates to zero.
hole theOrbitalTracesVanishOffS:
  forall f: TestFunction; forall s: PlaceSet;
    isAdmissibleFor(s, f) -> theOffSPiecesVanish(s, f)

// Theorem 12.4.1.1 (S-local Trace calculation), txt line 31123 — proved. The S-local
// integral equals the left (geometric) side of (12.5.1.1), after subtracting the two Mellin
// terms.
hole theSLocalTraceCalculation:
  forall f: TestFunction; forall s: PlaceSet;
    isAdmissibleFor(s, f) -> theKernelDecomposes(s, f) ->
      theSLocalIntegralIsTheGeometricSide(s, f)

// Definition 10.4.3.7 (Global Spectral and Geometric Kernels), txt line 28655, together
// with Theorem 10.4.2.8 (Spectral side: convolution after projection), txt line 27947 —
// both proved. Equation (12.5.1.4): the global kernel integral IS the spectral side.
hole theSpectralSideIsTheKernelIntegral:
  forall f: TestFunction;
    isTestFunction(f) -> theGlobalIntegralIsTheSpectralSide(f)

// The final combination, "Upon combining (12.5.1.4) with the foregoing". Assembly only:
// given the decomposition, the vanishing, both side identifications, the identity follows.
hole theTwoSidesCombine:
  forall f: TestFunction; forall s: PlaceSet;
    theOffSPiecesVanish(s, f) -> theSLocalIntegralIsTheGeometricSide(s, f) ->
      theGlobalIntegralIsTheSpectralSide(f) -> theTraceFormulaHoldsAt(f)

// ---------------------------------------------------------------------------------------
// THE PROOF of Theorem 12.5.1.1, assembled from the above. Every step kernel-checked.
// ---------------------------------------------------------------------------------------

theorem theTraceFormula: forall f: TestFunction;
  isTestFunction(f) -> vanishesOnTheNormOneIdeles(f) -> theTraceFormulaHoldsAt(f)
proof
  @generalize-phi |
    fix phi: TestFunction {
      @given-test-function |
        assume isTestFunction(phi) {
          @given-vanishing |
            assume vanishesOnTheNormOneIdeles(phi) {
              @is-test-function |
                isTestFunction(phi)
                [by hypothesis given-test-function]

              // step 1: choose an admissible S
              @admissible-all |
                forall f: TestFunction;
                  isTestFunction(f) -> exists s: PlaceSet; isAdmissibleFor(s, f)
                [by cite anAdmissibleSetOfPlacesExists]
              @admissible-at-phi |
                isTestFunction(phi) -> exists s: PlaceSet; isAdmissibleFor(s, phi)
                [by apply_at(phi) admissible-all]
              @some-admissible-s |
                exists s: PlaceSet; isAdmissibleFor(s, phi)
                [by modus_ponens admissible-at-phi is-test-function]

              // steps 2-6 inside the witness
              @with-s |
                unpack s: PlaceSet from some-admissible-s {
                  @s-admissible |
                    isAdmissibleFor(s, phi)
                    [by hypothesis with-s]

                  // step 2: the kernel decomposes
                  @decomp-all |
                    forall f: TestFunction; forall t: PlaceSet;
                      isAdmissibleFor(t, f) -> theKernelDecomposes(t, f)
                    [by cite theGeometricKernelDecomposition]
                  @decomp-at-phi |
                    forall t: PlaceSet; isAdmissibleFor(t, phi) -> theKernelDecomposes(t, phi)
                    [by apply_at(phi) decomp-all]
                  @decomp-at-s |
                    isAdmissibleFor(s, phi) -> theKernelDecomposes(s, phi)
                    [by apply_at(s) decomp-at-phi]
                  @decomposes |
                    theKernelDecomposes(s, phi)
                    [by modus_ponens decomp-at-s s-admissible]

                  // step 3: off-S pieces vanish (Thm 11.3.2.1)
                  @vanish-all |
                    forall f: TestFunction; forall t: PlaceSet;
                      isAdmissibleFor(t, f) -> theOffSPiecesVanish(t, f)
                    [by cite theOrbitalTracesVanishOffS]
                  @vanish-at-phi |
                    forall t: PlaceSet; isAdmissibleFor(t, phi) -> theOffSPiecesVanish(t, phi)
                    [by apply_at(phi) vanish-all]
                  @vanish-at-s |
                    isAdmissibleFor(s, phi) -> theOffSPiecesVanish(s, phi)
                    [by apply_at(s) vanish-at-phi]
                  @vanishes |
                    theOffSPiecesVanish(s, phi)
                    [by modus_ponens vanish-at-s s-admissible]

                  // step 4: the S-local calculation (Thm 12.4.1.1)
                  @slocal-all |
                    forall f: TestFunction; forall t: PlaceSet;
                      isAdmissibleFor(t, f) -> theKernelDecomposes(t, f) ->
                        theSLocalIntegralIsTheGeometricSide(t, f)
                    [by cite theSLocalTraceCalculation]
                  @slocal-at-phi |
                    forall t: PlaceSet;
                      isAdmissibleFor(t, phi) -> theKernelDecomposes(t, phi) ->
                        theSLocalIntegralIsTheGeometricSide(t, phi)
                    [by apply_at(phi) slocal-all]
                  @slocal-at-s |
                    isAdmissibleFor(s, phi) -> theKernelDecomposes(s, phi) ->
                      theSLocalIntegralIsTheGeometricSide(s, phi)
                    [by apply_at(s) slocal-at-phi]
                  @slocal-needs-decomp |
                    theKernelDecomposes(s, phi) ->
                      theSLocalIntegralIsTheGeometricSide(s, phi)
                    [by modus_ponens slocal-at-s s-admissible]
                  @geometric-side |
                    theSLocalIntegralIsTheGeometricSide(s, phi)
                    [by modus_ponens slocal-needs-decomp decomposes]

                  // step 5: the spectral side (Def 10.4.3.7 + Thm 10.4.2.8)
                  @spectral-all |
                    forall f: TestFunction;
                      isTestFunction(f) -> theGlobalIntegralIsTheSpectralSide(f)
                    [by cite theSpectralSideIsTheKernelIntegral]
                  @spectral-at-phi |
                    isTestFunction(phi) -> theGlobalIntegralIsTheSpectralSide(phi)
                    [by apply_at(phi) spectral-all]
                  @spectral-side |
                    theGlobalIntegralIsTheSpectralSide(phi)
                    [by modus_ponens spectral-at-phi is-test-function]

                  // step 6: combine
                  @combine-all |
                    forall f: TestFunction; forall t: PlaceSet;
                      theOffSPiecesVanish(t, f) ->
                        theSLocalIntegralIsTheGeometricSide(t, f) ->
                          theGlobalIntegralIsTheSpectralSide(f) -> theTraceFormulaHoldsAt(f)
                    [by cite theTwoSidesCombine]
                  @combine-at-phi |
                    forall t: PlaceSet;
                      theOffSPiecesVanish(t, phi) ->
                        theSLocalIntegralIsTheGeometricSide(t, phi) ->
                          theGlobalIntegralIsTheSpectralSide(phi) -> theTraceFormulaHoldsAt(phi)
                    [by apply_at(phi) combine-all]
                  @combine-at-s |
                    theOffSPiecesVanish(s, phi) ->
                      theSLocalIntegralIsTheGeometricSide(s, phi) ->
                        theGlobalIntegralIsTheSpectralSide(phi) -> theTraceFormulaHoldsAt(phi)
                    [by apply_at(s) combine-at-phi]
                  @combine-needs-geometric |
                    theSLocalIntegralIsTheGeometricSide(s, phi) ->
                      theGlobalIntegralIsTheSpectralSide(phi) -> theTraceFormulaHoldsAt(phi)
                    [by modus_ponens combine-at-s vanishes]
                  @combine-needs-spectral |
                    theGlobalIntegralIsTheSpectralSide(phi) -> theTraceFormulaHoldsAt(phi)
                    [by modus_ponens combine-needs-geometric geometric-side]
                  @holds-inner |
                    theTraceFormulaHoldsAt(phi)
                    [by modus_ponens combine-needs-spectral spectral-side]
                }
              @holds |
                theTraceFormulaHoldsAt(phi)
                [by unpacked with-s]
            }
          @discharge-vanishing |
            vanishesOnTheNormOneIdeles(phi) -> theTraceFormulaHoldsAt(phi)
            [by discharge given-vanishing]
        }
      @discharge-test-function |
        isTestFunction(phi) -> vanishesOnTheNormOneIdeles(phi) -> theTraceFormulaHoldsAt(phi)
        [by discharge given-test-function]
    }
  @conclusion |
    forall f: TestFunction;
      isTestFunction(f) -> vanishesOnTheNormOneIdeles(f) -> theTraceFormulaHoldsAt(f)
    [by generalize generalize-phi]
qed
