// The shared vocabulary of the formalization — the sorts and predicates that more than one
// layer needs. Every other file imports this with `theory vocab <<< "vocabulary.b4m"`.
//
// WHY THIS FILE EXISTS. Each layer of the dependency map (grh.b4m, trace-formula.b4m, …)
// talks about the same objects: test functions, the Trace Formula holding at one, the zeros
// of a Hecke L-function. Declared separately per file they would be DIFFERENT sorts that
// merely look alike, and `grh.b4m` could not cite `theTraceFormula` at all — identity in
// 2b4m is by ORIGIN, not by spelling. So the shared names live here, declared once.
//
// ALTITUDE. Everything is opaque: no analysis is modelled. The sorts carry no structure and
// the predicates no definitions, because the question this formalization answers is "what
// does the GRH claim rest on", not "is the analysis correct". See README.md.

// ---------------------------------------------------------------------------------------
// the objects
// ---------------------------------------------------------------------------------------

/// an element of D(C_F): the manuscript's test functions on the idele class group
sort TestFunction
/// a non-trivial zero of the Hecke L-function under consideration
sort Zero
/// a point of the complex plane
sort Complex
/// a finite set S of places of F
sort PlaceSet

/// s = 1/2, the centre of the critical strip
const theCentralPoint: Complex

// ---------------------------------------------------------------------------------------
// test functions
// ---------------------------------------------------------------------------------------

/// phi is smooth and compactly supported: phi in D(C_F)
pred isTestFunction(f: TestFunction)

/// phi(C_F^1) = 0 — the manuscript's standing hypothesis (1.7.2.1). The author is explicit
/// that it "cannot be removed. It stays there until after GRH is deduced from the Trace
/// Formula", and that it is what makes Weil's Positivity Criterion unavailable: positivity
/// needs phi = psi1 * psi2, and the only such phi satisfying this is identically zero.
pred vanishesOnTheNormOneIdeles(f: TestFunction)

/// phi is one of the §1.4.2 mollified approximants to phi_z(t) = t^{-z}
pred isAMollifiedPowerApproximant(f: TestFunction)

// ---------------------------------------------------------------------------------------
// the Trace Formula
// ---------------------------------------------------------------------------------------

/// A quantity in the trace calculation: an integral along the diagonal, or one side of
/// (12.5.1.1). Opaque, but a TERM rather than a predicate — the manuscript's final step
/// substitutes equations about the same integral, which needs terms to be checkable.
sort Quantity

/// the left (geometric) side of (12.5.1.1)
oper theGeometricSide(f: TestFunction) => Quantity
/// the right (spectral) side of (12.5.1.1)
oper theSpectralSide(f: TestFunction) => Quantity

/// the two sides of (12.5.1.1) agree at phi — Theorem 12.5.1.1, p. 519. DEFINED, not
/// opaque: "the Trace Formula holds" IS the equality of its two sides, and saying so lets a
/// consumer cite the trace-formula layer's equation directly.
pred theTraceFormulaHoldsAt(f: TestFunction):
  theTraceFormulaHoldsAt(f) iff theGeometricSide(f) = theSpectralSide(f).

// ---------------------------------------------------------------------------------------
// the GRH deduction (§1.4)
// ---------------------------------------------------------------------------------------

/// the non-Archimedean sum at phi approximates L'_f/L_f — §1.4.4
pred theNonArchimedeanSumComputesTheLogDerivative(f: TestFunction)
/// L'_f(s+1/2, chi)/L_f(s+1/2, chi) is holomorphic on C_{>0} minus {1/2} — §1.4.5
pred theLogDerivativeIsHolomorphicOffTheCentralPoint()
/// rho is a non-trivial zero of the Hecke L-function under consideration
pred isNonTrivialZero(r: Zero)

// THE CRITICAL LINE, WITH CONTENT. An earlier version declared `onTheCriticalLine` as an
// OPAQUE predicate and `noZerosRight/Left` as opaque NULLARY ones. That made GRH's
// statement vacuous: an adversarial probe derived the OPPOSITE conclusion ("no non-trivial
// zero is on the line") from the same antecedents in the same shape, because nothing
// related the three predicates. The final hole carried the entire connection, so the
// theorem said "opaque-P(r) implies opaque-Q(r)" rather than anything about zeros.
//
// The fix is to say what the critical line IS, in the only terms this altitude has: a zero
// is on it exactly when it is neither right of it nor left of it. That is a trichotomy on
// the real part, and it is the content §1.4.5 actually uses — the manuscript excludes the
// two open half-planes and concludes the line. With this definition, the last step of the
// GRH deduction becomes a KERNEL-CHECKED derivation instead of an assumption.

/// the zero lies strictly right of the critical line: Re(rho) > 1/2
pred rightOfTheCriticalLine(r: Zero)
/// the zero lies strictly left of the critical line: Re(rho) < 1/2
pred leftOfTheCriticalLine(r: Zero)

/// sigma(rho) = 1/2 — DEFINED as "neither side", which is what excluding both half-planes
/// gives. GRH is: every non-trivial zero satisfies this.
pred onTheCriticalLine(r: Zero):
  onTheCriticalLine(r) iff
  ((not rightOfTheCriticalLine(r)) and (not leftOfTheCriticalLine(r))).

// THESE TWO ARE DEFINITIONS, BUT `--axioms` REPORTS THEM AS ASSUMPTIONS. Read them that way.
//
// They are declared + axiomatized rather than written as definition blocks only because a
// definition clause cannot infer a bound variable's sort under a quantifier (2b4m PAINPOINTS
// entry 16), and both bodies quantify over Zero. Semantically each SAYS WHAT ITS PREDICATE
// MEANS — it introduces no constraint on anything that existed before — so neither is an
// assumption about the mathematics.
//
// But the spelling `axiom` makes `--axioms` list them beside real assumptions, where a
// definition block would have been labelled DEFINITION and set apart. Since this artifact's
// whole deliverable is an honest assumption count, that mislabelling matters: when quoting
// totals, these two belong with the 5 definitions, not with the 37 cited holes. They were
// introduced in the same change that gave the critical line content, and an audit of the
// --axioms output caught them.

/// L(s, chi) has no zeros with real part > 1/2 — a statement ABOUT zeros
pred noZerosRightOfTheCriticalLine()
axiom noZerosRightMeansNoZeroIsRight:
  noZerosRightOfTheCriticalLine() iff
  (forall r: Zero; isNonTrivialZero(r) -> (not rightOfTheCriticalLine(r)))

/// L(s, chi) has no zeros with real part < 1/2 — a statement ABOUT zeros
pred noZerosLeftOfTheCriticalLine()
axiom noZerosLeftMeansNoZeroIsLeft:
  noZerosLeftOfTheCriticalLine() iff
  (forall r: Zero; isNonTrivialZero(r) -> (not leftOfTheCriticalLine(r)))
